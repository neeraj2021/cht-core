      <bind nodeset="/data/group_summary_s2/grp_s2_filled_by/calc_s2_reporter" type="string" calculate=" /data/reporter_name "/>
      <bind nodeset="/data/group_summary_s2/grp_s2_patient/lbl_s2_patient" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_patient/calc_s2_patient" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/group_summary_s2/grp_s2_state/lbl_s2_state" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_state/calc_s2_state_lbl" type="string" calculate="jr:choice-name( /data/inputs/state , ' /data/inputs/state ')"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_district/lbl_s2_district" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_district/calc_s2_district_lbl" type="string" calculate="jr:choice-name( /data/inputs/district , ' /data/inputs/district ')"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q1/lbl_s2_q1" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q1/calc_s2_q1" type="string" calculate="jr:choice-name( /data/cbe_page_1/trained_individual_sbe , ' /data/cbe_page_1/trained_individual_sbe ')"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q2/lbl_s2_q2" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q2/calc_s2_q2" type="string" calculate="jr:choice-name( /data/cbe_page_1/lump_in_breast_cbe , ' /data/cbe_page_1/lump_in_breast_cbe ')"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q3/lbl_s2_q3" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q3/calc_s2_q3" type="string" calculate="jr:choice-name( /data/cbe_page_2/swelling_in_armpit_cbe , ' /data/cbe_page_2/swelling_in_armpit_cbe ')"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q4/lbl_s2_q4" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q4/calc_s2_q4" type="string" calculate="jr:choice-name( /data/cbe_page_2/nipple_retraction_distortion , ' /data/cbe_page_2/nipple_retraction_distortion ')"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q5/lbl_s2_q5" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q5/calc_s2_q5" type="string" calculate="jr:choice-name( /data/cbe_page_3/ulceration_cbe , ' /data/cbe_page_3/ulceration_cbe ')"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q6/lbl_s2_q6" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q6/calc_s2_q6" type="string" calculate="jr:choice-name( /data/cbe_page_3/discharge_from_nipple_cbe , ' /data/cbe_page_3/discharge_from_nipple_cbe ')"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q7/lbl_s2_q7" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary_s2/grp_s2_q7/calc_s2_q7" type="string" calculate="jr:choice-name( /data/cbe_page_4/skin_dimpling_retraction , ' /data/cbe_page_4/skin_dimpling_retraction ')"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages grid-layout">
    <group appearance="field-list" ref="/data/intro_page">
      <label>About This Screening</label>
      <input ref="/data/intro_page/intro_note">
        <label>Breast Cancer Screening is advised for women above 40 years. Breast cancer is curable if detected on time. This screening will take approximately 10 minutes.</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/inputs">
      <label>Patient &amp; Reporter Info</label>
      <group ref="/data/inputs/user"/>
      <input ref="/data/inputs/reporter_name_note">
        <label> Filled by: <output value=" /data/reporter_name "/></label>
      </input>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-person role-patient">
          <label>Patient's Name</label>
          <hint>Select the patient from your area</hint>
        </input>
        <input ref="/data/inputs/contact/patient_id" appearance="hidden">
          <label>Medic ID</label>
        </input>
        <input ref="/data/inputs/contact/name" appearance="hidden">
          <label>Patient Name</label>
        </input>
      </group>
      <select1 ref="/data/inputs/state" appearance="minimal">
        <label>State</label>
        <itemset nodeset="instance('states')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/inputs/district" appearance="minimal">
        <label>District</label>
        <itemset nodeset="instance('districts')/root/item[filter =  /data/inputs/state ]">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/section1_intro_page">
      <label>Section 1: Breast Symptom Exam</label>
      <input ref="/data/section1_intro_page/section1_intro_note">
        <label ref="jr:itext('/data/section1_intro_page/section1_intro_note:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/symptoms_page_1">
      <label>Breast Symptoms (1–2)</label>
      <select1 ref="/data/symptoms_page_1/any_breast_related_symptoms">
        <label>Any Breast Related Symptoms?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/symptoms_page_1/lump_or_thickening_in_breast">
        <label>Lump or Thickening in Breast?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/symptoms_page_2">
      <label>Breast Symptoms (3–4)</label>
      <select1 ref="/data/symptoms_page_2/change_in_size">
        <label>Change in Size?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/symptoms_page_2/change_in_shape_position">
        <label>Change in Shape &amp; Position of Nipple?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/symptoms_page_3">
      <label>Breast Symptoms (5–6)</label>
      <select1 ref="/data/symptoms_page_3/any_retraction_of_nipple">
        <label>Any Retraction of Nipple?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/symptoms_page_3/discharge_from_nipple_s1">
        <label>Discharge from One or Both Nipples?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/symptoms_page_4">
      <label>Breast Symptoms (7–8)</label>
      <select1 ref="/data/symptoms_page_4/puckering_or_dimpling">
        <label>Puckering or Dimpling?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/symptoms_page_4/swelling_lump_in_armpit">
        <label>Swelling/Lump in Armpit?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/symptoms_page_5">
      <label>Breast Symptoms (9–10)</label>
      <select1 ref="/data/symptoms_page_5/constant_pain_breast_armpit">
        <label>Constant Pain in Breast or Armpit?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/symptoms_page_5/redness_of_skin_over_breast">
        <label>Redness of Skin over Breast or Any Ulcer?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/symptoms_page_6">
      <label>Breast Symptoms (11)</label>
      <select1 ref="/data/symptoms_page_6/erosions_of_nipple">
        <label>Erosions of Nipple?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/group_summary_s1">
      <label>Section 1: Assessment Summary for Breast Symptom Exam</label>
      <group ref="/data/group_summary_s1/grp_s1_filled_by">
        <input ref="/data/group_summary_s1/grp_s1_filled_by/lbl_s1_filled_by">
          <label> **Filled by:** <output value=" /data/reporter_name "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_patient">
        <input ref="/data/group_summary_s1/grp_s1_patient/lbl_s1_patient">
          <label> **Patient:** <output value=" /data/patient_name "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_state">
        <input ref="/data/group_summary_s1/grp_s1_state/lbl_s1_state">
          <label> **State:** <output value=" /data/group_summary_s1/grp_s1_state/calc_s1_state_lbl "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_district">
        <input ref="/data/group_summary_s1/grp_s1_district/lbl_s1_district">
          <label> **District:** <output value=" /data/group_summary_s1/grp_s1_district/calc_s1_district_lbl "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_q1">
        <input ref="/data/group_summary_s1/grp_s1_q1/lbl_s1_q1">
          <label> **1. Any Breast Related Symptoms?** <output value=" /data/group_summary_s1/grp_s1_q1/calc_s1_q1 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_q2">
        <input ref="/data/group_summary_s1/grp_s1_q2/lbl_s1_q2">
          <label> **2. Lump or Thickening in Breast?** <output value=" /data/group_summary_s1/grp_s1_q2/calc_s1_q2 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_q3">
        <input ref="/data/group_summary_s1/grp_s1_q3/lbl_s1_q3">
          <label> **3. Change in Size?** <output value=" /data/group_summary_s1/grp_s1_q3/calc_s1_q3 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_q4">
        <input ref="/data/group_summary_s1/grp_s1_q4/lbl_s1_q4">
          <label> **4. Change in Shape &amp; Position of Nipple?** <output value=" /data/group_summary_s1/grp_s1_q4/calc_s1_q4 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_q5">
        <input ref="/data/group_summary_s1/grp_s1_q5/lbl_s1_q5">
          <label> **5. Any Retraction of Nipple?** <output value=" /data/group_summary_s1/grp_s1_q5/calc_s1_q5 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_q6">
        <input ref="/data/group_summary_s1/grp_s1_q6/lbl_s1_q6">
          <label> **6. Discharge from One or Both Nipples?** <output value=" /data/group_summary_s1/grp_s1_q6/calc_s1_q6 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_q7">
        <input ref="/data/group_summary_s1/grp_s1_q7/lbl_s1_q7">
          <label> **7. Puckering or Dimpling?** <output value=" /data/group_summary_s1/grp_s1_q7/calc_s1_q7 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_q8">
        <input ref="/data/group_summary_s1/grp_s1_q8/lbl_s1_q8">
          <label> **8. Swelling/Lump in Armpit?** <output value=" /data/group_summary_s1/grp_s1_q8/calc_s1_q8 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_q9">
        <input ref="/data/group_summary_s1/grp_s1_q9/lbl_s1_q9">
          <label> **9. Constant Pain in Breast or Armpit?** <output value=" /data/group_summary_s1/grp_s1_q9/calc_s1_q9 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_q10">
        <input ref="/data/group_summary_s1/grp_s1_q10/lbl_s1_q10">
          <label> **10. Redness of Skin over Breast or Any Ulcer?** <output value=" /data/group_summary_s1/grp_s1_q10/calc_s1_q10 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_q11">
        <input ref="/data/group_summary_s1/grp_s1_q11/lbl_s1_q11">
          <label> **11. Erosions of Nipple?** <output value=" /data/group_summary_s1/grp_s1_q11/calc_s1_q11 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s1/grp_s1_symptom_status">
        <input ref="/data/group_summary_s1/grp_s1_symptom_status/lbl_s1_symptom_status">
          <label> **Symptom Status:** <output value=" /data/group_summary_s1/grp_s1_symptom_status/calc_symptom_status_lbl "/></label>
        </input>
      </group>
    </group>
    <group appearance="field-list" ref="/data/section2_gate_page">
      <label>Clinical Breast Exam</label>
      <select1 ref="/data/section2_gate_page/do_section2">
        <label>Proceed with Clinical Breast Exam (Section 2)?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/section2_intro_page">
      <label>Section 2: Clinical Breast Exam</label>
      <input ref="/data/section2_intro_page/section2_intro_note">
        <label ref="jr:itext('/data/section2_intro_page/section2_intro_note:label')"/>
      </input>
      <input ref="/data/section2_intro_page/section2_intro_note_2">
        <label>During a clinical breast exam, or CBE, a health care provider looks at and feels the breasts. They will also check under the arms for lumps or anything else that seems unusual.</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/cbe_page_1">
      <label>Clinical Breast Exam (1–2)</label>
      <select1 ref="/data/cbe_page_1/trained_individual_sbe">
        <label>Trained Individual for Self Breast Exam?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/cbe_page_1/lump_in_breast_cbe">
        <label>Lump in Breast?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/cbe_page_2">
      <label>Clinical Breast Exam (3–4)</label>
      <select1 ref="/data/cbe_page_2/swelling_in_armpit_cbe">
        <label>Swelling in Armpit?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/cbe_page_2/nipple_retraction_distortion">
        <label>Nipple Retraction/Distortion?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/cbe_page_3">
      <label>Clinical Breast Exam (5–6)</label>
      <select1 ref="/data/cbe_page_3/ulceration_cbe">
        <label>Ulceration?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/cbe_page_3/discharge_from_nipple_cbe">
        <label>Discharge from Nipple?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/cbe_page_4">
      <label>Clinical Breast Exam (7)</label>
      <select1 ref="/data/cbe_page_4/skin_dimpling_retraction">
        <label>Skin Dimpling/Retraction?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/group_summary_s2">
      <label>Section 2: Assessment Summary for Clinic Breast Exam</label>
      <group ref="/data/group_summary_s2/grp_s2_filled_by">
        <input ref="/data/group_summary_s2/grp_s2_filled_by/lbl_s2_filled_by">
          <label> **Filled by:** <output value=" /data/reporter_name "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s2/grp_s2_patient">
        <input ref="/data/group_summary_s2/grp_s2_patient/lbl_s2_patient">
          <label> **Patient:** <output value=" /data/patient_name "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s2/grp_s2_state">
        <input ref="/data/group_summary_s2/grp_s2_state/lbl_s2_state">
          <label> **State:** <output value=" /data/group_summary_s2/grp_s2_state/calc_s2_state_lbl "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s2/grp_s2_district">
        <input ref="/data/group_summary_s2/grp_s2_district/lbl_s2_district">
          <label> **District:** <output value=" /data/group_summary_s2/grp_s2_district/calc_s2_district_lbl "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s2/grp_s2_q1">
        <input ref="/data/group_summary_s2/grp_s2_q1/lbl_s2_q1">
          <label> **1. Trained Individual for Self Breast Exam?** <output value=" /data/group_summary_s2/grp_s2_q1/calc_s2_q1 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s2/grp_s2_q2">
        <input ref="/data/group_summary_s2/grp_s2_q2/lbl_s2_q2">
          <label> **2. Lump in Breast?** <output value=" /data/group_summary_s2/grp_s2_q2/calc_s2_q2 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s2/grp_s2_q3">
        <input ref="/data/group_summary_s2/grp_s2_q3/lbl_s2_q3">
          <label> **3. Swelling in Armpit?** <output value=" /data/group_summary_s2/grp_s2_q3/calc_s2_q3 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s2/grp_s2_q4">
        <input ref="/data/group_summary_s2/grp_s2_q4/lbl_s2_q4">
          <label> **4. Nipple Retraction/Distortion?** <output value=" /data/group_summary_s2/grp_s2_q4/calc_s2_q4 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s2/grp_s2_q5">
        <input ref="/data/group_summary_s2/grp_s2_q5/lbl_s2_q5">
          <label> **5. Ulceration?** <output value=" /data/group_summary_s2/grp_s2_q5/calc_s2_q5 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s2/grp_s2_q6">
        <input ref="/data/group_summary_s2/grp_s2_q6/lbl_s2_q6">
          <label> **6. Discharge from Nipple?** <output value=" /data/group_summary_s2/grp_s2_q6/calc_s2_q6 "/></label>
        </input>
      </group>
      <group ref="/data/group_summary_s2/grp_s2_q7">
        <input ref="/data/group_summary_s2/grp_s2_q7/lbl_s2_q7">
          <label> **7. Skin Dimpling/Retraction?** <output value=" /data/group_summary_s2/grp_s2_q7/calc_s2_q7 "/></label>
        </input>
      </group>
    </group>
  </h:body>
</h:html>