      <bind nodeset="/data/form_1_summary/grp_lbl_oral_cancer_treat/calc_oral_cancer_treat_lbl" type="string" calculate="jr:choice-name( /data/personal_history/treat_oral_cancer ,' /data/personal_history/treat_oral_cancer ')"/>
      <bind nodeset="/data/form_1_summary/grp_lbl_other_disease/lbl_other_disease" readonly="true()" type="string"/>
      <bind nodeset="/data/form_1_summary/grp_lbl_other_disease/calc_other_disease" type="string" calculate=" /data/personal_history/other_disease "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/title "/>
    </model>
