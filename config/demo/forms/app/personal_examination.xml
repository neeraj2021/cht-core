      <bind nodeset="/data/personal_history/diag_oral_cancer" type="string" required="true()"/>
      <bind nodeset="/data/personal_history/treat_oral_cancer" type="string" required="true()" relevant=" /data/personal_history/diag_oral_cancer  = 'yes'"/>
      <bind nodeset="/data/personal_history/other_disease" type="string" constraint="string-length(.) &lt;= 500" jr:constraintMsg="Maximum 500 characters allowed."/>
