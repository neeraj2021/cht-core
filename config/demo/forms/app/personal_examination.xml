      <bind nodeset="/data/patient_id" type="string" calculate="../inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/reporter_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/reporter_place" type="string" calculate="instance('user-contact-summary')/context/facility_name"/>
      <bind nodeset="/data/title" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/about_intro/about_intro_note" readonly="true()" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/user/phone" type="string"/>
      <bind nodeset="/data/inputs/reporter_name_note" readonly="true()" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="string" required="true()"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/state" type="string" required="true()"/>
      <bind nodeset="/data/inputs/district" type="string" required="true()"/>
      <bind nodeset="/data/intro_form_1" readonly="true()" type="string"/>
      <bind nodeset="/data/form_1_personal_details/height_cm" type="decimal" required="true()" constraint=". &gt;= 1 and . &lt;= 230" jr:constraintMsg="Height must be between 1 and 230 cm."/>
      <bind nodeset="/data/form_1_personal_details/weight_kg" type="decimal" required="true()" constraint=". &gt;= 1 and . &lt;= 300" jr:constraintMsg="Weight must be between 1 and 300 kg."/>
      <bind nodeset="/data/form_1_personal_details/bmi" type="string" calculate="if( /data/form_1_personal_details/height_cm  &gt; 0 and  /data/form_1_personal_details/weight_kg  &gt; 0, round( /data/form_1_personal_details/weight_kg  div ( /data/form_1_personal_details/height_cm  *  /data/form_1_personal_details/height_cm  div 10000), 1), '')"/>
      <bind nodeset="/data/form_1_personal_details/bmi_display" readonly="true()" type="string" relevant=" /data/form_1_personal_details/height_cm  != '' and  /data/form_1_personal_details/weight_kg  != ''"/>
      <bind nodeset="/data/intro_personal_history" readonly="true()" type="string"/>
      <bind nodeset="/data/personal_history/diag_diabetes" type="string" required="true()"/>
      <bind nodeset="/data/personal_history/treat_diabetes" type="string" required="true()" relevant=" /data/personal_history/diag_diabetes  = 'yes'"/>
      <bind nodeset="/data/personal_history/diag_bp" type="string" required="true()"/>
      <bind nodeset="/data/personal_history/treat_bp" type="string" required="true()" relevant=" /data/personal_history/diag_bp  = 'yes'"/>
      <bind nodeset="/data/personal_history/diag_heart" type="string" required="true()"/>
      <bind nodeset="/data/personal_history/treat_heart" type="string" required="true()" relevant=" /data/personal_history/diag_heart  = 'yes'"/>
      <bind nodeset="/data/personal_history/diag_stroke" type="string" required="true()"/>
      <bind nodeset="/data/personal_history/treat_stroke" type="string" required="true()" relevant=" /data/personal_history/diag_stroke  = 'yes'"/>
      <bind nodeset="/data/personal_history/diag_kidney" type="string" required="true()"/>
      <bind nodeset="/data/personal_history/treat_kidney" type="string" required="true()" relevant=" /data/personal_history/diag_kidney  = 'yes'"/>
