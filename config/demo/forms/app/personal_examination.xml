        <hint>Enter height in centimetres</hint>
      </input>
      <input ref="/data/form_1_personal_details/weight_kg">
        <label>Weight (kg)</label>
        <hint>Enter weight in kilograms</hint>
      </input>
      <input ref="/data/form_1_personal_details/bmi_display">
