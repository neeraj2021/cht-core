<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>NCD Diabetes Referral</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="ncd_diabetes_referral" prefix="J1!ncd_diabetes_referral!" delimiter="#">
          <patient_id/>
          <patient_uuid/>
          <patient_name/>
          <reporter_name/>
          <title/>
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <name/>
              <phone/>
            </user>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
            </contact>
            <t_rapid_glucose/>
          </inputs>
          <referral>
            <glucose_note/>
            <phc_visited/>
            <willing_to_visit/>
            <not_willing_note/>
            <phc_visit_date/>
            <t_phc_visited/>
            <t_willing_to_visit/>
            <t_phc_visit_date/>
          </referral>
          <meta tag="hidden">
            <instanceID/>
            <instanceName/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/patient_id" type="string" calculate="../inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/reporter_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/title" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/user/phone" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="string" readonly="true()"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/t_rapid_glucose" type="string"/>
      <bind nodeset="/data/referral/glucose_note" readonly="true()" type="string"/>
      <bind nodeset="/data/referral/phc_visited" type="string" required="true()"/>
      <bind nodeset="/data/referral/willing_to_visit" type="string" required="true()" relevant=" /data/referral/phc_visited  = 'no'"/>
      <bind nodeset="/data/referral/not_willing_note" readonly="true()" type="string" relevant=" /data/referral/phc_visited  = 'no' and  /data/referral/willing_to_visit  = 'no'"/>
      <bind nodeset="/data/referral/phc_visit_date" type="date" required="true()" relevant=" /data/referral/phc_visited  = 'no' and  /data/referral/willing_to_visit  = 'yes'"/>
      <bind nodeset="/data/referral/t_phc_visited" type="string" calculate=" /data/referral/phc_visited "/>
      <bind nodeset="/data/referral/t_willing_to_visit" type="string" calculate=" /data/referral/willing_to_visit "/>
      <bind nodeset="/data/referral/t_phc_visit_date" type="string" calculate=" /data/referral/phc_visit_date "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/title "/>
    </model>
  </h:head>
  <h:body class="pages grid-layout">
    <group appearance="field-list" ref="/data/inputs">
      <label>Patient &amp; CHW Info</label>
      <group ref="/data/inputs/user"/>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-person role-patient">
          <label>Patient's Name</label>
        </input>
        <input ref="/data/inputs/contact/patient_id" appearance="hidden">
          <label>Medic ID</label>
        </input>
        <input ref="/data/inputs/contact/name" appearance="hidden">
          <label>Patient Name</label>
        </input>
      </group>
    </group>
    <group appearance="field-list" ref="/data/referral">
      <label>Diabetes PHC Referral</label>
      <input ref="/data/referral/glucose_note">
        <label> **Previous Rapid Glucose Reading:** <output value=" /data/inputs/t_rapid_glucose "/> mg/dL </label>
      </input>
      <select1 ref="/data/referral/phc_visited">
        <label>Did the patient visit the PHC?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/referral/willing_to_visit">
        <label>Is the patient willing to visit the PHC?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/referral/not_willing_note">
        <label>Patient is not willing to visit PHC.</label>
      </input>
      <input ref="/data/referral/phc_visit_date">
        <label>When will the patient visit the PHC?</label>
      </input>
    </group>
  </h:body>
</h:html>