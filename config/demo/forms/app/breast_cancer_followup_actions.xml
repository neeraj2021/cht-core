<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Breast Cancer Follow-up Actions</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="breast_cancer_followup_actions" prefix="J1!breast_cancer_followup_actions!" delimiter="#">
          <patient_id/>
          <patient_uuid/>
          <patient_name/>
          <reporter_name/>
          <title/>
          <form_start_timestamp/>
          <form_sync_timestamp/>
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <name/>
              <phone/>
            </user>
            <reporter_name_note/>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
            </contact>
            <previous_risk_score/>
            <previous_risk_category/>
          </inputs>
          <context_note/>
          <page_fu1>
            <referral_status/>
          </page_fu1>
          <page_fu2>
            <lifestyle_counselling/>
          </page_fu2>
          <page_fu3>
            <screening_scheduled/>
            <action_notes/>
          </page_fu3>
          <group_summary>
            <grp_patient>
              <lbl_patient_lbl/>
              <calc_patient_name/>
            </grp_patient>
            <grp_prev_score>
              <lbl_prev_score_lbl/>
              <calc_previous_risk_score/>
            </grp_prev_score>
            <grp_risk_category>
              <lbl_risk_category_lbl/>
              <calc_previous_risk_category/>
            </grp_risk_category>
            <grp_reporter>
              <lbl_reporter_lbl/>
              <calc_reporter_name/>
            </grp_reporter>
          </group_summary>
          <form_submit_timestamp/>
          <meta tag="hidden">
            <instanceID/>
            <instanceName/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="referral_action">
        <root>
          <item>
            <name>referred_oncologist</name>
            <label>Yes — referred to oncologist / cancer specialist</label>
          </item>
          <item>
            <name>referred_gynaecologist</name>
            <label>Yes — referred to gynaecologist</label>
          </item>
          <item>
            <name>referred_primary</name>
            <label>Referred to primary health centre for further evaluation</label>
          </item>
          <item>
            <name>not_yet</name>
            <label>Not yet — planned for next visit</label>
          </item>
          <item>
            <name>declined</name>
            <label>Patient declined referral</label>
          </item>
        </root>
      </instance>
      <instance id="lifestyle_change">
        <root>
          <item>
            <name>yes_full</name>
            <label>Yes — full counselling provided</label>
          </item>
          <item>
            <name>yes_partial</name>
            <label>Yes — partial counselling provided</label>
          </item>
          <item>
            <name>no_planned</name>
            <label>No — planned for next visit</label>
          </item>
          <item>
            <name>no_not_applicable</name>
            <label>Not applicable at this stage</label>
          </item>
        </root>
      </instance>
      <instance id="screening_plan">
        <root>
          <item>
            <name>mammogram_scheduled</name>
            <label>Mammogram scheduled</label>
          </item>
          <item>
            <name>clinical_exam_scheduled</name>
            <label>Clinical breast exam scheduled</label>
          </item>
          <item>
            <name>self_exam_taught</name>
            <label>Self-examination taught; annual review planned</label>
          </item>
          <item>
            <name>routine_annual</name>
            <label>Routine annual screening (low risk)</label>
          </item>
          <item>
            <name>urgent_imaging</name>
            <label>Urgent imaging / biopsy referral initiated</label>
          </item>
          <item>
            <name>no_plan</name>
            <label>No plan yet — to be decided</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/patient_id" type="string" calculate="/data/inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="/data/inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="/data/inputs/contact/name"/>
      <bind nodeset="/data/reporter_name" type="string" calculate="/data/inputs/user/name"/>
      <bind nodeset="/data/title" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/form_start_timestamp" type="string" calculate="once(if( /data/inputs/contact/_id  != '', now(), ''))"/>
      <bind nodeset="/data/form_sync_timestamp" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/user/phone" type="string"/>
      <bind nodeset="/data/inputs/reporter_name_note" readonly="true()" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="string" required="true()"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string" calculate="/data/inputs/contact/patient_id"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/previous_risk_score" type="string"/>
      <bind nodeset="/data/inputs/previous_risk_category" type="string"/>
      <bind nodeset="/data/context_note" readonly="true()" type="string"/>
      <bind nodeset="/data/page_fu1/referral_status" type="string" required="true()"/>
      <bind nodeset="/data/page_fu2/lifestyle_counselling" type="string" required="true()"/>
      <bind nodeset="/data/page_fu3/screening_scheduled" type="string" required="true()"/>
      <bind nodeset="/data/page_fu3/action_notes" type="string"/>
      <bind nodeset="/data/group_summary/grp_patient/lbl_patient_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_patient/calc_patient_name" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/group_summary/grp_prev_score/lbl_prev_score_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_prev_score/calc_previous_risk_score" type="string" calculate=" /data/inputs/previous_risk_score "/>
      <bind nodeset="/data/group_summary/grp_risk_category/lbl_risk_category_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_risk_category/calc_previous_risk_category" type="string" calculate=" /data/inputs/previous_risk_category "/>
      <bind nodeset="/data/group_summary/grp_reporter/lbl_reporter_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_reporter/calc_reporter_name" type="string" calculate=" /data/reporter_name "/>
      <bind nodeset="/data/form_submit_timestamp" type="string" calculate="now()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/title "/>
    </model>
  </h:head>
  <h:body class="pages grid-layout @hiddenInReportsList">
    <group appearance="field-list" ref="/data/inputs">
      <label>Patient &amp; Reporter Info</label>
      <group ref="/data/inputs/user"/>
      <input ref="/data/inputs/reporter_name_note">
        <label> Filled by: <output value=" /data/reporter_name "/></label>
      </input>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-person role-patient">
          <label>Patient's Name</label>
          <hint>Select the patient from your area</hint>
        </input>
        <input ref="/data/inputs/contact/patient_id" appearance="hidden">
          <label>Medic ID</label>
        </input>
        <input ref="/data/inputs/contact/name" appearance="hidden">
          <label>Patient Name</label>
        </input>
      </group>
    </group>
    <input ref="/data/context_note">
      <label> Breast Cancer Follow-up | Risk Score: <output value=" /data/inputs/previous_risk_score "/> | Category: <output value=" /data/inputs/previous_risk_category "/></label>
    </input>
    <group appearance="field-list" ref="/data/page_fu1">
      <label>Follow-up Question 1 of 3</label>
      <select1 ref="/data/page_fu1/referral_status">
        <label>1. Has the patient been referred to a specialist or oncologist following the risk assessment?</label>
        <hint>Indicate whether a referral has been initiated.</hint>
        <itemset nodeset="instance('referral_action')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_fu2">
      <label>Follow-up Question 2 of 3</label>
      <select1 ref="/data/page_fu2/lifestyle_counselling">
        <label>2. Has the patient received counselling on lifestyle modifications to reduce breast cancer risk?</label>
        <hint>e.g. diet, physical activity, breastfeeding guidance, alcohol avoidance.</hint>
        <itemset nodeset="instance('lifestyle_change')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_fu3">
      <label>Follow-up Question 3 of 3</label>
      <select1 ref="/data/page_fu3/screening_scheduled">
        <label>3. What is the patient's breast cancer screening plan?</label>
        <hint>Select the most appropriate next step based on risk category.</hint>
        <itemset nodeset="instance('screening_plan')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/page_fu3/action_notes">
        <label>Additional notes (optional)</label>
        <hint>Any other relevant observations, referrals, or follow-up plans.</hint>
      </input>
    </group>
    <group appearance="field-list" ref="/data/group_summary">
      <label>Follow-up Summary</label>
      <group appearance="field-list" ref="/data/group_summary/grp_patient">
        <input ref="/data/group_summary/grp_patient/lbl_patient_lbl">
          <label> **Patient:** <output value=" /data/patient_name "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_prev_score">
        <input ref="/data/group_summary/grp_prev_score/lbl_prev_score_lbl">
          <label> **Risk Score:** <output value=" /data/inputs/previous_risk_score "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_risk_category">
        <input ref="/data/group_summary/grp_risk_category/lbl_risk_category_lbl">
          <label> **Risk Category:** <output value=" /data/inputs/previous_risk_category "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_reporter">
        <input ref="/data/group_summary/grp_reporter/lbl_reporter_lbl">
          <label> **Filled by:** <output value=" /data/reporter_name "/></label>
        </input>
      </group>
    </group>
  </h:body>
</h:html>