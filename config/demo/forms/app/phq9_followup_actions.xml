<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>PHQ-9 Follow-up Actions</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="phq9_followup_actions" prefix="J1!phq9_followup_actions!" delimiter="#">
          <patient_id/>
          <patient_uuid/>
          <patient_name/>
          <reporter_name/>
          <title/>
          <form_start_timestamp/>
          <form_sync_timestamp/>
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <name/>
              <phone/>
            </user>
            <reporter_name_note/>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
            </contact>
            <previous_score/>
            <previous_severity/>
          </inputs>
          <context_note/>
          <page_fu1>
            <safety_concern/>
          </page_fu1>
          <page_fu2>
            <social_support/>
          </page_fu2>
          <page_fu3>
            <clinician_action/>
            <action_notes/>
          </page_fu3>
          <group_summary>
            <grp_patient>
              <lbl_patient_lbl/>
              <calc_patient_name/>
            </grp_patient>
            <grp_prev_score>
              <lbl_prev_score_lbl/>
              <calc_previous_score/>
            </grp_prev_score>
            <grp_severity>
              <lbl_severity_lbl/>
              <calc_previous_severity/>
            </grp_severity>
            <grp_reporter>
              <lbl_reporter_lbl/>
              <calc_reporter_name/>
            </grp_reporter>
          </group_summary>
          <form_submit_timestamp/>
          <meta tag="hidden">
            <instanceID/>
            <instanceName/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="support_level">
        <root>
          <item>
            <name>strong</name>
            <label>Strong — family/community actively involved</label>
          </item>
          <item>
            <name>moderate</name>
            <label>Moderate — some support available</label>
          </item>
          <item>
            <name>weak</name>
            <label>Weak — limited or no support</label>
          </item>
          <item>
            <name>unknown</name>
            <label>Unknown / not assessed</label>
          </item>
        </root>
      </instance>
      <instance id="action_taken">
        <root>
          <item>
            <name>referred_psychiatry</name>
            <label>Referred to psychiatrist / mental health specialist</label>
          </item>
          <item>
            <name>referred_counselling</name>
            <label>Referred to counsellor / psychologist</label>
          </item>
          <item>
            <name>medication_initiated</name>
            <label>Medication initiated / adjusted</label>
          </item>
          <item>
            <name>safety_plan_created</name>
            <label>Safety plan created with patient</label>
          </item>
          <item>
            <name>watchful_waiting</name>
            <label>Watchful waiting — scheduled follow-up</label>
          </item>
          <item>
            <name>emergency_referral</name>
            <label>Emergency referral (immediate risk)</label>
          </item>
          <item>
            <name>other</name>
            <label>Other (describe in notes)</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/patient_id" type="string" calculate="/data/inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="/data/inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="/data/inputs/contact/name"/>
      <bind nodeset="/data/reporter_name" type="string" calculate="/data/inputs/user/name"/>
      <bind nodeset="/data/title" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/form_start_timestamp" type="string" calculate="once(if( /data/inputs/contact/_id  != '', now(), ''))"/>
      <bind nodeset="/data/form_sync_timestamp" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/user/phone" type="string"/>
      <bind nodeset="/data/inputs/reporter_name_note" readonly="true()" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="string" required="true()"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string" calculate="/data/inputs/contact/patient_id"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/previous_score" type="string"/>
      <bind nodeset="/data/inputs/previous_severity" type="string"/>
      <bind nodeset="/data/context_note" readonly="true()" type="string"/>
      <bind nodeset="/data/page_fu1/safety_concern" type="string" required="true()"/>
      <bind nodeset="/data/page_fu2/social_support" type="string" required="true()"/>
      <bind nodeset="/data/page_fu3/clinician_action" type="string" required="true()"/>
      <bind nodeset="/data/page_fu3/action_notes" type="string"/>
      <bind nodeset="/data/group_summary/grp_patient/lbl_patient_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_patient/calc_patient_name" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/group_summary/grp_prev_score/lbl_prev_score_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_prev_score/calc_previous_score" type="string" calculate=" /data/inputs/previous_score "/>
      <bind nodeset="/data/group_summary/grp_severity/lbl_severity_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_severity/calc_previous_severity" type="string" calculate=" /data/inputs/previous_severity "/>
      <bind nodeset="/data/group_summary/grp_reporter/lbl_reporter_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_reporter/calc_reporter_name" type="string" calculate=" /data/reporter_name "/>
      <bind nodeset="/data/form_submit_timestamp" type="string" calculate="now()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/title "/>
    </model>
  </h:head>
  <h:body class="pages grid-layout @hiddenInReportsList">
    <group appearance="field-list" ref="/data/inputs">
      <label>Patient &amp; Reporter Info</label>
      <group ref="/data/inputs/user"/>
      <input ref="/data/inputs/reporter_name_note">
        <label> Filled by: <output value=" /data/reporter_name "/></label>
      </input>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-person role-patient">
          <label>Patient's Name</label>
          <hint>Select the patient from your area</hint>
        </input>
        <input ref="/data/inputs/contact/patient_id" appearance="hidden">
          <label>Medic ID</label>
        </input>
        <input ref="/data/inputs/contact/name" appearance="hidden">
          <label>Patient Name</label>
        </input>
      </group>
    </group>
    <input ref="/data/context_note">
      <label> PHQ-9 Follow-up | Score: <output value=" /data/inputs/previous_score "/>/27 | Severity: <output value=" /data/inputs/previous_severity "/></label>
    </input>
    <group appearance="field-list" ref="/data/page_fu1">
      <label>Follow-up Question 1 of 3</label>
      <select1 ref="/data/page_fu1/safety_concern">
        <label>1. Is the patient currently expressing thoughts of self-harm or suicide?</label>
        <hint>Based on direct conversation with the patient.</hint>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_fu2">
      <label>Follow-up Question 2 of 3</label>
      <select1 ref="/data/page_fu2/social_support">
        <label>2. How would you describe the patient's current social support system?</label>
        <hint>Consider family, friends, community, or other caregivers available.</hint>
        <itemset nodeset="instance('support_level')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_fu3">
      <label>Follow-up Question 3 of 3</label>
      <select1 ref="/data/page_fu3/clinician_action">
        <label>3. What action has been taken or recommended following this assessment?</label>
        <hint>Select the most appropriate next step.</hint>
        <itemset nodeset="instance('action_taken')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/page_fu3/action_notes">
        <label>Additional notes (optional)</label>
        <hint>Any other relevant observations, referrals, or follow-up plans.</hint>
      </input>
    </group>
    <group appearance="field-list" ref="/data/group_summary">
      <label>Follow-up Summary</label>
      <group appearance="field-list" ref="/data/group_summary/grp_patient">
        <input ref="/data/group_summary/grp_patient/lbl_patient_lbl">
          <label> **Patient:** <output value=" /data/patient_name "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_prev_score">
        <input ref="/data/group_summary/grp_prev_score/lbl_prev_score_lbl">
          <label> **PHQ-9 Score:** <output value=" /data/inputs/previous_score "/>/27 </label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_severity">
        <input ref="/data/group_summary/grp_severity/lbl_severity_lbl">
          <label> **Severity:** <output value=" /data/inputs/previous_severity "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_reporter">
        <input ref="/data/group_summary/grp_reporter/lbl_reporter_lbl">
          <label> **Filled by:** <output value=" /data/reporter_name "/></label>
        </input>
      </group>
    </group>
  </h:body>
</h:html>