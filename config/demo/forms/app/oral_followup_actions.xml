<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Oral Cancer Follow-up Actions</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="oral_followup_actions" prefix="J1!oral_followup_actions!" delimiter="#">
          <patient_id/>
          <patient_uuid/>
          <patient_name/>
          <reporter_name/>
          <title/>
          <form_start_timestamp/>
          <form_sync_timestamp/>
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <name/>
              <phone/>
            </user>
            <reporter_name_note/>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
            </contact>
            <patient_age/>
            <patient_gender/>
          </inputs>
          <context_note/>
          <page_fu1>
            <habit_cessation_status/>
          </page_fu1>
          <page_fu2>
            <oral_lesion_status/>
          </page_fu2>
          <page_fu3>
            <referral_status/>
            <action_notes/>
          </page_fu3>
          <group_summary>
            <grp_patient>
              <lbl_patient_lbl/>
              <calc_patient_name/>
            </grp_patient>
            <grp_age>
              <lbl_age_lbl/>
              <calc_patient_age/>
            </grp_age>
            <grp_gender>
              <lbl_gender_lbl/>
              <calc_patient_gender/>
            </grp_gender>
            <grp_reporter>
              <lbl_reporter_lbl/>
              <calc_reporter_name/>
            </grp_reporter>
          </group_summary>
          <form_submit_timestamp/>
          <meta tag="hidden">
            <instanceID/>
            <instanceName/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="habit_cessation">
        <root>
          <item>
            <name>yes_full</name>
            <label>Yes — full cessation counselling provided</label>
          </item>
          <item>
            <name>yes_partial</name>
            <label>Yes — partial counselling provided</label>
          </item>
          <item>
            <name>no_planned</name>
            <label>No — planned for next visit</label>
          </item>
          <item>
            <name>not_applicable</name>
            <label>Not applicable — no harmful habits identified</label>
          </item>
        </root>
      </instance>
      <instance id="lesion_followup">
        <root>
          <item>
            <name>resolved</name>
            <label>Resolved — no lesion observed at follow-up</label>
          </item>
          <item>
            <name>improving</name>
            <label>Improving — lesion reducing in size or severity</label>
          </item>
          <item>
            <name>unchanged</name>
            <label>Unchanged — lesion present, no change</label>
          </item>
          <item>
            <name>worsened</name>
            <label>Worsened — lesion has increased or spread</label>
          </item>
          <item>
            <name>no_lesion</name>
            <label>No lesion was noted in original assessment</label>
          </item>
        </root>
      </instance>
      <instance id="referral_action">
        <root>
          <item>
            <name>referred_dentist</name>
            <label>Yes — referred to dentist</label>
          </item>
          <item>
            <name>referred_oral_surgeon</name>
            <label>Yes — referred to oral surgeon</label>
          </item>
          <item>
            <name>referred_oncologist</name>
            <label>Yes — referred to oncologist</label>
          </item>
          <item>
            <name>not_yet</name>
            <label>Not yet — planned for next visit</label>
          </item>
          <item>
            <name>not_required</name>
            <label>Not required at this stage</label>
          </item>
          <item>
            <name>declined</name>
            <label>Patient declined referral</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/patient_id" type="string" calculate="/data/inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="/data/inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="/data/inputs/contact/name"/>
      <bind nodeset="/data/reporter_name" type="string" calculate="/data/inputs/user/name"/>
      <bind nodeset="/data/title" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/form_start_timestamp" type="string" calculate="once(if( /data/inputs/contact/_id  != '', now(), ''))"/>
      <bind nodeset="/data/form_sync_timestamp" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/user/phone" type="string"/>
      <bind nodeset="/data/inputs/reporter_name_note" readonly="true()" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="string" required="true()"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string" calculate="/data/inputs/contact/patient_id"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/patient_age" type="string"/>
      <bind nodeset="/data/inputs/patient_gender" type="string"/>
      <bind nodeset="/data/context_note" readonly="true()" type="string"/>
      <bind nodeset="/data/page_fu1/habit_cessation_status" type="string" required="true()"/>
      <bind nodeset="/data/page_fu2/oral_lesion_status" type="string" required="true()"/>
      <bind nodeset="/data/page_fu3/referral_status" type="string" required="true()"/>
      <bind nodeset="/data/page_fu3/action_notes" type="string"/>
      <bind nodeset="/data/group_summary/grp_patient/lbl_patient_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_patient/calc_patient_name" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/group_summary/grp_age/lbl_age_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_age/calc_patient_age" type="string" calculate=" /data/inputs/patient_age "/>
      <bind nodeset="/data/group_summary/grp_gender/lbl_gender_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_gender/calc_patient_gender" type="string" calculate=" /data/inputs/patient_gender "/>
      <bind nodeset="/data/group_summary/grp_reporter/lbl_reporter_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_reporter/calc_reporter_name" type="string" calculate=" /data/reporter_name "/>
      <bind nodeset="/data/form_submit_timestamp" type="string" calculate="now()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/title "/>
    </model>
  </h:head>
  <h:body class="pages grid-layout @hiddenInReportsList">
    <group appearance="field-list" ref="/data/inputs">
      <label>Patient &amp; Reporter Info</label>
      <group ref="/data/inputs/user"/>
      <input ref="/data/inputs/reporter_name_note">
        <label> Filled by: <output value=" /data/reporter_name "/></label>
      </input>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-person role-patient">
          <label>Patient's Name</label>
          <hint>Select the patient from your area</hint>
        </input>
        <input ref="/data/inputs/contact/patient_id" appearance="hidden">
          <label>Medic ID</label>
        </input>
        <input ref="/data/inputs/contact/name" appearance="hidden">
          <label>Patient Name</label>
        </input>
      </group>
    </group>
    <input ref="/data/context_note">
      <label> Oral Cancer Follow-up | Age: <output value=" /data/inputs/patient_age "/> | Gender: <output value=" /data/inputs/patient_gender "/></label>
    </input>
    <group appearance="field-list" ref="/data/page_fu1">
      <label>Follow-up Question 1 of 3</label>
      <select1 ref="/data/page_fu1/habit_cessation_status">
        <label>1. Has the patient been counselled on cessation of tobacco, areca nut, or alcohol use identified during the assessment?</label>
        <hint>Select the most appropriate response based on the follow-up visit.</hint>
        <itemset nodeset="instance('habit_cessation')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_fu2">
      <label>Follow-up Question 2 of 3</label>
      <select1 ref="/data/page_fu2/oral_lesion_status">
        <label>2. What is the current status of any oral lesion or suspicious finding noted during the assessment?</label>
        <hint>Based on clinical observation or patient report at follow-up.</hint>
        <itemset nodeset="instance('lesion_followup')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_fu3">
      <label>Follow-up Question 3 of 3</label>
      <select1 ref="/data/page_fu3/referral_status">
        <label>3. Has the patient been referred to a dentist, oral surgeon, or oncologist for further evaluation?</label>
        <hint>Select the action taken or planned.</hint>
        <itemset nodeset="instance('referral_action')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/page_fu3/action_notes">
        <label>Additional notes (optional)</label>
        <hint>Any other relevant observations, referrals, or follow-up plans.</hint>
      </input>
    </group>
    <group appearance="field-list" ref="/data/group_summary">
      <label>Follow-up Summary</label>
      <group appearance="field-list" ref="/data/group_summary/grp_patient">
        <input ref="/data/group_summary/grp_patient/lbl_patient_lbl">
          <label> **Patient:** <output value=" /data/patient_name "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_age">
        <input ref="/data/group_summary/grp_age/lbl_age_lbl">
          <label> **Age:** <output value=" /data/inputs/patient_age "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_gender">
        <input ref="/data/group_summary/grp_gender/lbl_gender_lbl">
          <label> **Gender:** <output value=" /data/inputs/patient_gender "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_reporter">
        <input ref="/data/group_summary/grp_reporter/lbl_reporter_lbl">
          <label> **Filled by:** <output value=" /data/reporter_name "/></label>
        </input>
      </group>
    </group>
  </h:body>
</h:html>