<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>NCD Hypertension Follow-up</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="ncd_hypertension_followup" prefix="J1!ncd_hypertension_followup!" delimiter="#">
          <patient_id/>
          <patient_uuid/>
          <patient_name/>
          <reporter_name/>
          <title/>
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <name/>
              <phone/>
            </user>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
            </contact>
            <t_systolic/>
            <t_diastolic/>
          </inputs>
          <followup>
            <bp_note/>
            <current_systolic/>
            <current_diastolic/>
            <medication_taken/>
            <referred_to_phc/>
            <notes/>
            <t_current_systolic/>
            <t_current_diastolic/>
            <t_medication_taken/>
            <t_referred_to_phc/>
          </followup>
          <meta tag="hidden">
            <instanceID/>
            <instanceName/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/patient_id" type="string" calculate="../inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/reporter_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/title" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/user/phone" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="string" required="true()"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/t_systolic" type="string"/>
      <bind nodeset="/data/inputs/t_diastolic" type="string"/>
      <bind nodeset="/data/followup/bp_note" readonly="true()" type="string"/>
      <bind nodeset="/data/followup/current_systolic" type="int" required="true()"/>
      <bind nodeset="/data/followup/current_diastolic" type="int" required="true()"/>
      <bind nodeset="/data/followup/medication_taken" type="string" required="true()"/>
      <bind nodeset="/data/followup/referred_to_phc" type="string" required="true()"/>
      <bind nodeset="/data/followup/notes" type="string"/>
      <bind nodeset="/data/followup/t_current_systolic" type="string" calculate=" /data/followup/current_systolic "/>
      <bind nodeset="/data/followup/t_current_diastolic" type="string" calculate=" /data/followup/current_diastolic "/>
      <bind nodeset="/data/followup/t_medication_taken" type="string" calculate=" /data/followup/medication_taken "/>
      <bind nodeset="/data/followup/t_referred_to_phc" type="string" calculate=" /data/followup/referred_to_phc "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/title "/>
    </model>
  </h:head>
  <h:body class="pages grid-layout">
    <group appearance="field-list" ref="/data/inputs">
      <label>Patient &amp; CHW Info</label>
      <group ref="/data/inputs/user"/>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-person role-patient">
          <label>Patient's Name</label>
        </input>
        <input ref="/data/inputs/contact/patient_id" appearance="hidden">
          <label>Medic ID</label>
        </input>
        <input ref="/data/inputs/contact/name" appearance="hidden">
          <label>Patient Name</label>
        </input>
      </group>
    </group>
    <group appearance="field-list" ref="/data/followup">
      <label>Hypertension Follow-up</label>
      <input ref="/data/followup/bp_note">
        <label> **Previous BP Reading:** <output value=" /data/inputs/t_systolic "/> / <output value=" /data/inputs/t_diastolic "/> mmHg </label>
      </input>
      <input ref="/data/followup/current_systolic">
        <label>Current Systolic (mmHg)</label>
        <hint>Enter current systolic reading</hint>
      </input>
      <input ref="/data/followup/current_diastolic">
        <label>Current Diastolic (mmHg)</label>
        <hint>Enter current diastolic reading</hint>
      </input>
      <select1 ref="/data/followup/medication_taken">
        <label>Is the patient taking prescribed medication?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/followup/referred_to_phc">
        <label>Has the patient been advised to visit the PHC?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/followup/notes">
        <label>Additional Notes (optional)</label>
      </input>
    </group>
  </h:body>
</h:html>