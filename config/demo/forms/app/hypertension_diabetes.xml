            <label>Thiruvananthapuram</label>
            <filter>kerala</filter>
          </item>
          <item>
            <name>kochi</name>
            <label>Kochi</label>
            <filter>kerala</filter>
          </item>
          <item>
            <name>kozhikode</name>
            <label>Kozhikode</label>
            <filter>kerala</filter>
          </item>
          <item>
