      </instance>
      <bind nodeset="/data/patient_id" type="string" calculate="../inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/reporter_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/reporter_place" type="string" calculate="instance('user-contact-summary')/context/facility_name"/>
      <bind nodeset="/data/title" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/about_intro/about_intro_note" readonly="true()" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/user/phone" type="string"/>
      <bind nodeset="/data/inputs/reporter_name_note" readonly="true()" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="string" required="true()"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/state" type="string" required="true()"/>
      <bind nodeset="/data/inputs/district" type="string" required="true()"/>
      <bind nodeset="/data/intro_form_2" readonly="true()" type="string"/>
      <bind nodeset="/data/hypertension/systolic" type="int" required="true()" constraint=". &gt;= 60 and . &lt;= 300" jr:constraintMsg="Systolic must be between 60 and 300 mmHg."/>
      <bind nodeset="/data/hypertension/diastolic" type="int" required="true()" constraint=". &gt;= 40 and . &lt;= 200" jr:constraintMsg="Diastolic must be between 40 and 200 mmHg."/>
      <bind nodeset="/data/bp_referral_page" relevant=" /data/hypertension/systolic  &gt; 140 or  /data/hypertension/diastolic  &gt; 90"/>
      <bind nodeset="/data/bp_referral_page/bp_referral_note" readonly="true()" type="string"/>
      <bind nodeset="/data/bp_referral_page/bp_referral_decision" type="string" required="true()" relevant=" /data/hypertension/systolic  &gt; 140 or  /data/hypertension/diastolic  &gt; 90"/>
      <bind nodeset="/data/bp_lifestyle_page" relevant="not( /data/hypertension/systolic  &gt; 140 or  /data/hypertension/diastolic  &gt; 90) and ( /data/hypertension/systolic  &gt; 120 and  /data/hypertension/diastolic  &gt; 80)"/>
      <bind nodeset="/data/bp_lifestyle_page/bp_lifestyle_note" readonly="true()" type="string"/>
      <bind nodeset="/data/bp_normal_page" relevant="not( /data/hypertension/systolic  &gt; 140 or  /data/hypertension/diastolic  &gt; 90) and not( /data/hypertension/systolic  &gt; 120 and  /data/hypertension/diastolic  &gt; 80)"/>
      <bind nodeset="/data/bp_normal_page/bp_normal_note" readonly="true()" type="string"/>
      <bind nodeset="/data/bp_normal_page/bp_referral_decision_normal" type="string" required="true()" relevant="not( /data/hypertension/systolic  &gt; 140 or  /data/hypertension/diastolic  &gt; 90) and not( /data/hypertension/systolic  &gt; 120 and  /data/hypertension/diastolic  &gt; 80)"/>
      <bind nodeset="/data/diabetes_section/rapid_glucose" type="int" required="true()" constraint=". &gt;= 20 and . &lt;= 600" jr:constraintMsg="Rapid glucose must be between 20 and 600 mg/dL."/>
      <bind nodeset="/data/glucose_referral_page" relevant=" /data/diabetes_section/rapid_glucose  &gt; 140"/>
      <bind nodeset="/data/glucose_referral_page/glucose_referral_note" readonly="true()" type="string"/>
      <bind nodeset="/data/glucose_referral_page/glucose_referral_decision" type="string" required="true()" relevant=" /data/diabetes_section/rapid_glucose  &gt; 140"/>
      <bind nodeset="/data/glucose_normal_page" relevant="not( /data/diabetes_section/rapid_glucose  &gt; 140)"/>
      <bind nodeset="/data/glucose_normal_page/glucose_normal_note" readonly="true()" type="string"/>
      <bind nodeset="/data/glucose_normal_page/glucose_referral_decision_normal" type="string" required="true()" relevant="not( /data/diabetes_section/rapid_glucose  &gt; 140)"/>
      <bind nodeset="/data/calc_state_lbl" type="string" calculate="jr:choice-name( /data/inputs/state ,' /data/inputs/state ')"/>
      <bind nodeset="/data/calc_district_lbl" type="string" calculate="jr:choice-name( /data/inputs/district ,' /data/inputs/district ')"/>
      <bind nodeset="/data/calc_bp_referral_lbl" type="string" calculate="if( /data/hypertension/systolic  &gt; 140 or  /data/hypertension/diastolic  &gt; 90, jr:choice-name( /data/bp_referral_page/bp_referral_decision ,' /data/bp_referral_page/bp_referral_decision '), if(not( /data/hypertension/systolic  &gt; 120 and  /data/hypertension/diastolic  &gt; 80), jr:choice-name( /data/bp_normal_page/bp_referral_decision_normal ,' /data/bp_normal_page/bp_referral_decision_normal '), ''))"/>
      <bind nodeset="/data/calc_glucose_referral_lbl" type="string" calculate="if( /data/diabetes_section/rapid_glucose  &gt; 140, jr:choice-name( /data/glucose_referral_page/glucose_referral_decision ,' /data/glucose_referral_page/glucose_referral_decision '), jr:choice-name( /data/glucose_normal_page/glucose_referral_decision_normal ,' /data/glucose_normal_page/glucose_referral_decision_normal '))"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_filled_by/lbl_filled_by" readonly="true()" type="string"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_filled_by/calc_reporter_name" type="string" calculate=" /data/reporter_name "/>
      <bind nodeset="/data/form_2_summary/grp_lbl_patient/lbl_patient" readonly="true()" type="string"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_patient/calc_patient_name" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/form_2_summary/grp_lbl_state/lbl_state" readonly="true()" type="string"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_state/calc_state_sum" type="string" calculate=" /data/calc_state_lbl "/>
      <bind nodeset="/data/form_2_summary/grp_lbl_district/lbl_district" readonly="true()" type="string"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_district/calc_district_sum" type="string" calculate=" /data/calc_district_lbl "/>
      <bind nodeset="/data/form_2_summary/grp_lbl_systolic/lbl_systolic" readonly="true()" type="string"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_systolic/calc_systolic" type="string" calculate=" /data/hypertension/systolic "/>
      <bind nodeset="/data/form_2_summary/grp_lbl_diastolic/lbl_diastolic" readonly="true()" type="string"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_diastolic/calc_diastolic" type="string" calculate=" /data/hypertension/diastolic "/>
      <bind nodeset="/data/form_2_summary/grp_lbl_bp_status/lbl_bp_status" readonly="true()" type="string"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_bp_status/calc_bp_status_lbl" type="string" calculate="if( /data/hypertension/systolic  &gt; 140 or  /data/hypertension/diastolic  &gt; 90, 'High Blood Pressure – Referral Required', if( /data/hypertension/systolic  &gt; 120 and  /data/hypertension/diastolic  &gt; 80, 'Lifestyle Modification Recommended', 'Normal'))"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_bp_referral" relevant="not( /data/hypertension/systolic  &gt; 120 and  /data/hypertension/diastolic  &gt; 80) or ( /data/hypertension/systolic  &gt; 140 or  /data/hypertension/diastolic  &gt; 90)"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_bp_referral/lbl_bp_referral" readonly="true()" type="string"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_bp_referral/calc_bp_referral_sum" type="string" calculate=" /data/calc_bp_referral_lbl "/>
      <bind nodeset="/data/form_2_summary/grp_lbl_glucose/lbl_glucose" readonly="true()" type="string"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_glucose/calc_rapid_glucose" type="string" calculate=" /data/diabetes_section/rapid_glucose "/>
      <bind nodeset="/data/form_2_summary/grp_lbl_glucose_status/lbl_glucose_status" readonly="true()" type="string"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_glucose_status/calc_glucose_status_lbl" type="string" calculate="if( /data/diabetes_section/rapid_glucose  &gt; 140, 'High Blood Glucose – Referral Required', 'Normal')"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_glucose_referral/lbl_glucose_referral" readonly="true()" type="string"/>
      <bind nodeset="/data/form_2_summary/grp_lbl_glucose_referral/calc_glucose_referral_sum" type="string" calculate=" /data/calc_glucose_referral_lbl "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/title "/>
    </model>
  </h:head>
  <h:body class="pages grid-layout">
    <group ref="/data/about_intro">
      <label>Hypertension Screening and Diabetes Form</label>
      <input ref="/data/about_intro/about_intro_note">
        <label>You will now fill Hypertension Screening and Diabetes Form. This will take 5 – 10 minutes</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/inputs">
      <label>Patient &amp; Reporter Info</label>
      <group ref="/data/inputs/user"/>
      <input ref="/data/inputs/reporter_name_note">
        <label> Filled by: <output value=" /data/reporter_name "/></label>
      </input>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-patient">
          <label>Patient's Name</label>
          <hint>Select the patient from your area</hint>
        </input>
        <input ref="/data/inputs/contact/patient_id" appearance="hidden">
          <label>Medic ID</label>
        </input>
        <input ref="/data/inputs/contact/name" appearance="hidden">
          <label>Patient Name</label>
        </input>
      </group>
      <select1 ref="/data/inputs/state" appearance="minimal">
        <label>State</label>
        <itemset nodeset="instance('states')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/inputs/district" appearance="minimal">
        <label>District</label>
        <itemset nodeset="instance('districts')/root/item[filter =  /data/inputs/state ]">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <input ref="/data/intro_form_2">
      <label>## Hypertension Screening and Diabetes Assessment
Please enter your blood pressure and blood glucose readings.</label>
    </input>
    <group appearance="field-list" ref="/data/hypertension">
      <label>Hypertension Screening</label>
      <input ref="/data/hypertension/systolic">
        <label>Systolic (mmHg)</label>
        <hint>Enter systolic pressure</hint>
      </input>
      <input ref="/data/hypertension/diastolic">
        <label>Diastolic (mmHg)</label>
        <hint>Enter diastolic pressure</hint>
      </input>
    </group>
    <group appearance="field-list" ref="/data/bp_referral_page">
      <label>BP Referral</label>
      <input ref="/data/bp_referral_page/bp_referral_note">
        <label>**High Blood Pressure Detected** Systolic &gt; 140 mmHg or Diastolic &gt; 90 mmHg. Referral is required.</label>
      </input>
      <select1 ref="/data/bp_referral_page/bp_referral_decision" appearance="radio">
        <label>Referral Decision</label>
        <itemset nodeset="instance('refer_only')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/bp_lifestyle_page">
      <label>Lifestyle Modification</label>
      <input ref="/data/bp_lifestyle_page/bp_lifestyle_note">
        <label>**Lifestyle Modification Recommended** Systolic &gt; 120 mmHg and Diastolic &gt; 80 mmHg. Please follow diet and lifestyle modification guidelines.</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/bp_normal_page">
      <label>BP Assessment</label>
      <input ref="/data/bp_normal_page/bp_normal_note">
        <label>**Blood Pressure Normal** Systolic ≤ 120 mmHg and Diastolic ≤ 80 mmHg.</label>
      </input>
      <select1 ref="/data/bp_normal_page/bp_referral_decision_normal" appearance="radio">
        <label>Referral Decision</label>
        <itemset nodeset="instance('referral')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/diabetes_section">
      <label>Diabetes Assessment</label>
      <input ref="/data/diabetes_section/rapid_glucose">
        <label>Rapid Glucose Test (mg/dL)</label>
        <hint>Enter blood glucose value</hint>
      </input>
    </group>
    <group appearance="field-list" ref="/data/glucose_referral_page">
      <label>Glucose Referral</label>
      <input ref="/data/glucose_referral_page/glucose_referral_note">
        <label>**High Blood Glucose Detected** Rapid Glucose &gt; 140 mg/dL. Referral is required.</label>
      </input>
      <select1 ref="/data/glucose_referral_page/glucose_referral_decision" appearance="radio">
        <label>Referral Decision</label>
        <itemset nodeset="instance('refer_only')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/glucose_normal_page">
      <label>Glucose Assessment</label>
      <input ref="/data/glucose_normal_page/glucose_normal_note">
        <label>**Blood Glucose Normal** Rapid Glucose ≤ 140 mg/dL.</label>
      </input>
      <select1 ref="/data/glucose_normal_page/glucose_referral_decision_normal" appearance="radio">
        <label>Referral Decision</label>
        <itemset nodeset="instance('referral')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/form_2_summary">
      <label>Assessment Summary for Hypertension Screening and Diabetes Assessment</label>
      <group appearance="field-list" ref="/data/form_2_summary/grp_lbl_filled_by">
        <input ref="/data/form_2_summary/grp_lbl_filled_by/lbl_filled_by">
          <label> **Filled by:** <output value=" /data/reporter_name "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/form_2_summary/grp_lbl_patient">
        <input ref="/data/form_2_summary/grp_lbl_patient/lbl_patient">
          <label> **Patient:** <output value=" /data/patient_name "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/form_2_summary/grp_lbl_state">
        <input ref="/data/form_2_summary/grp_lbl_state/lbl_state">
          <label> **State:** <output value=" /data/calc_state_lbl "/></label>
