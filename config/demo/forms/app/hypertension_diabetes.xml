<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Hypertension Screening and Diabetes Assessment</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="hypertension_diabetes" prefix="J1!hypertension_diabetes!" delimiter="#">
          <patient_id/>
          <patient_uuid/>
          <patient_name/>
          <reporter_name/>
          <reporter_place/>
          <title/>
          <about_intro>
            <about_intro_note/>
          </about_intro>
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <name/>
              <phone/>
            </user>
            <reporter_name_note/>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
            </contact>
            <state/>
            <district/>
          </inputs>
          <intro_form_2/>
          <hypertension>
            <systolic/>
            <diastolic/>
          </hypertension>
          <bp_referral_page>
            <bp_referral_note/>
            <bp_referral_decision/>
          </bp_referral_page>
          <bp_lifestyle_page>
            <bp_lifestyle_note/>
          </bp_lifestyle_page>
          <bp_normal_page>
            <bp_normal_note/>
            <bp_referral_decision_normal/>
          </bp_normal_page>
          <diabetes_section>
            <rapid_glucose/>
          </diabetes_section>
          <glucose_referral_page>
            <glucose_referral_note/>
            <glucose_referral_decision/>
          </glucose_referral_page>
          <glucose_normal_page>
            <glucose_normal_note/>
            <glucose_referral_decision_normal/>
          </glucose_normal_page>
          <calc_state_lbl/>
          <calc_district_lbl/>
          <calc_bp_referral_lbl/>
          <calc_glucose_referral_lbl/>
          <form_2_summary>
            <grp_lbl_filled_by>
              <lbl_filled_by/>
              <calc_reporter_name/>
            </grp_lbl_filled_by>
            <grp_lbl_patient>
              <lbl_patient/>
              <calc_patient_name/>
            </grp_lbl_patient>
            <grp_lbl_state>
              <lbl_state/>
              <calc_state_sum/>
            </grp_lbl_state>
            <grp_lbl_district>
              <lbl_district/>
              <calc_district_sum/>
            </grp_lbl_district>
            <grp_lbl_systolic>
              <lbl_systolic/>
              <calc_systolic/>
            </grp_lbl_systolic>
            <grp_lbl_diastolic>
              <lbl_diastolic/>
              <calc_diastolic/>
            </grp_lbl_diastolic>
            <grp_lbl_bp_status>
              <lbl_bp_status/>
              <calc_bp_status_lbl/>
            </grp_lbl_bp_status>
            <grp_lbl_bp_referral>
              <lbl_bp_referral/>
              <calc_bp_referral_sum/>
            </grp_lbl_bp_referral>
            <grp_lbl_glucose>
              <lbl_glucose/>
              <calc_rapid_glucose/>
            </grp_lbl_glucose>
            <grp_lbl_glucose_status>
              <lbl_glucose_status/>
              <calc_glucose_status_lbl/>
            </grp_lbl_glucose_status>
            <grp_lbl_glucose_referral>
              <lbl_glucose_referral/>
              <calc_glucose_referral_sum/>
            </grp_lbl_glucose_referral>
          </form_2_summary>
          <meta tag="hidden">
            <instanceID/>
            <instanceName/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="referral">
        <root>
          <item>
            <name>do_not_refer</name>
            <label>Don't Refer</label>
          </item>
          <item>
            <name>refer_anyway</name>
            <label>Refer Anyway</label>
          </item>
        </root>
      </instance>
      <instance id="refer_only">
        <root>
          <item>
            <name>refer_anyway</name>
            <label>Refer</label>
          </item>
        </root>
      </instance>
      <instance id="states">
        <root>
          <item>
            <name>kerala</name>
            <label>Kerala</label>
          </item>
          <item>
            <name>tamil_nadu</name>
            <label>Tamil Nadu</label>
          </item>
          <item>
            <name>andhra_pradesh</name>
            <label>Andhra Pradesh</label>
          </item>
          <item>
            <name>telangana</name>
            <label>Telangana</label>
          </item>
          <item>
            <name>karnataka</name>
            <label>Karnataka</label>
          </item>
        </root>
      </instance>
      <instance id="districts">
        <root>
          <item>
            <name>chennai</name>
            <label>Chennai</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>thanjavur</name>
