          </item>
          <item>
            <name>0</name>
            <label>90 cm or less</label>
            <filter>male</filter>
          </item>
          <item>
            <name>1</name>
            <label>81-90 cm</label>
            <filter>female</filter>
          </item>
          <item>
            <name>1</name>
            <label>91-100 cm</label>
            <filter>male</filter>
          </item>
          <item>
            <name>2</name>
            <label>More than 90 cm</label>
            <filter>female</filter>
          </item>
          <item>
            <name>2</name>
            <label>More than 100 cm</label>
            <filter>male</filter>
          </item>
        </root>
      </instance>
      <instance id="gender">
        <root>
          <item>
            <name>male</name>
            <label>Male</label>
          </item>
          <item>
            <name>female</name>
