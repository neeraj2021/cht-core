      <bind nodeset="/data/patient_id" type="string" calculate="../inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/reporter_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/reporter_place" type="string" calculate="instance('user-contact-summary')/context/facility_name"/>
      <bind nodeset="/data/title" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/form_start_timestamp" type="string" calculate="once(if( /data/inputs/contact/_id  != '', now(), ''))"/>
      <bind nodeset="/data/form_sync_timestamp" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/user/phone" type="string"/>
      <bind nodeset="/data/inputs/reporter_name_note" readonly="true()" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="string" required="true()"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/gender" type="string" required="true()"/>
      <bind nodeset="/data/inputs/state" type="string" required="true()"/>
      <bind nodeset="/data/inputs/district" type="string" required="true()"/>
      <bind nodeset="/data/total_question" type="string" calculate="if( /data/inputs/contact/gender  = 'male', '0', '7')"/>
      <bind nodeset="/data/instructions" readonly="true()" type="string"/>
      <bind nodeset="/data/page_1a/age_range" type="string" required="true()"/>
      <bind nodeset="/data/page_1a/smoke_frequency" type="string" required="true()"/>
      <bind nodeset="/data/page_1a/alcohol_frequency" type="string" required="true()"/>
      <bind nodeset="/data/page_1b/waist_size" type="string" required="true()"/>
      <bind nodeset="/data/page_1b/physical_activities_frequency" type="string" required="true()"/>
      <bind nodeset="/data/page_1b/family_medical_history" type="string" required="true()"/>
      <bind nodeset="/data/total_score" type="string" calculate=" /data/page_1a/age_range  +  /data/page_1a/smoke_frequency  +  /data/page_1a/alcohol_frequency  +  /data/page_1b/waist_size  +  /data/page_1b/physical_activities_frequency  +  /data/page_1b/family_medical_history "/>
      <bind nodeset="/data/risk_category" type="string" calculate="if( /data/total_score  &gt; 4, 'High Risk', 'Low Risk')"/>
      <bind nodeset="/data/page_score/score_display" readonly="true()" type="string"/>
      <bind nodeset="/data/page_score/risk_display" readonly="true()" type="string"/>
      <bind nodeset="/data/page_score/score_high_note" readonly="true()" type="string" relevant=" /data/total_score  &gt; 4"/>
      <bind nodeset="/data/page_score/score_low_note" readonly="true()" type="string" relevant=" /data/total_score  &lt;= 4"/>
      <bind nodeset="/data/page_3a" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3a/breast_lump" type="string" required="true()" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3a/nipple_discharge" type="string" required="true()" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3a/breast_shape_size_change" type="string" required="true()" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3b" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3b/bleeding_between_periods" type="string" required="true()" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3b/post_menopause_bleeding" type="string" required="true()" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3b/post_intercourse_bleeding" type="string" required="true()" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3c" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3c/foul_smelling_vaginal_discharge" type="string" required="true()" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_4_phq2/phq2_instructions" readonly="true()" type="string"/>
      <bind nodeset="/data/page_4_phq2/phq2_q1" type="string" required="true()"/>
      <bind nodeset="/data/page_4_phq2/phq2_q2" type="string" required="true()"/>
      <bind nodeset="/data/phq2_total" type="string" calculate=" /data/page_4_phq2/phq2_q1  +  /data/page_4_phq2/phq2_q2 "/>
      <bind nodeset="/data/page_4_phq2_score/phq2_score_display" readonly="true()" type="string"/>
      <bind nodeset="/data/page_4_phq2_score/phq2_referral_note" readonly="true()" type="string" relevant=" /data/phq2_total  &gt; 3"/>
      <bind nodeset="/data/group_summary/grp_filled_by/lbl_filled_by" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_filled_by/calc_reporter" type="string" calculate=" /data/reporter_name "/>
      <bind nodeset="/data/group_summary/grp_patient/lbl_patient" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_patient/calc_patient" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/group_summary/grp_gender/lbl_gender" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_gender/calc_gender" type="string" calculate=" /data/inputs/contact/gender "/>
      <bind nodeset="/data/group_summary/grp_state/lbl_state" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_state/calc_state" type="string" calculate=" /data/inputs/state "/>
      <bind nodeset="/data/group_summary/grp_district/lbl_district" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_district/calc_district" type="string" calculate=" /data/inputs/district "/>
      <bind nodeset="/data/group_summary/grp_score/lbl_score" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_score/calc_score" type="string" calculate=" /data/total_score "/>
      <bind nodeset="/data/group_summary/grp_risk/lbl_risk" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_risk/calc_risk" type="string" calculate=" /data/risk_category "/>
      <bind nodeset="/data/group_summary/sum_hdr_a" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_q_age/q_age" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_q_age/calc_q_age" type="string" calculate=" /data/page_1a/age_range "/>
      <bind nodeset="/data/group_summary/grp_q_smoke/q_smoke" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_q_smoke/calc_q_smoke" type="string" calculate=" /data/page_1a/smoke_frequency "/>
      <bind nodeset="/data/group_summary/grp_q_alcohol/q_alcohol" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_q_alcohol/calc_q_alcohol" type="string" calculate=" /data/page_1a/alcohol_frequency "/>
      <bind nodeset="/data/group_summary/grp_q_waist/q_waist" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_q_waist/calc_q_waist" type="string" calculate=" /data/page_1b/waist_size "/>
      <bind nodeset="/data/group_summary/grp_q_physical/q_physical" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_q_physical/calc_q_physical" type="string" calculate=" /data/page_1b/physical_activities_frequency "/>
      <bind nodeset="/data/group_summary/grp_q_family/q_family" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_q_family/calc_q_family" type="string" calculate=" /data/page_1b/family_medical_history "/>
      <bind nodeset="/data/group_summary/sum_hdr_b" readonly="true()" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_breast_lump" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_breast_lump/q_breast_lump" readonly="true()" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_breast_lump/calc_q_breast_lump" type="string" calculate=" /data/page_3a/breast_lump "/>
      <bind nodeset="/data/group_summary/grp_q_nipple" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_nipple/q_nipple" readonly="true()" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_nipple/calc_q_nipple" type="string" calculate=" /data/page_3a/nipple_discharge "/>
      <bind nodeset="/data/group_summary/grp_q_breast_shape" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_breast_shape/q_breast_shape" readonly="true()" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_breast_shape/calc_q_breast_shape" type="string" calculate=" /data/page_3a/breast_shape_size_change "/>
      <bind nodeset="/data/group_summary/grp_q_bleeding_periods" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_bleeding_periods/q_bleeding_periods" readonly="true()" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_bleeding_periods/calc_q_bleeding_periods" type="string" calculate=" /data/page_3b/bleeding_between_periods "/>
      <bind nodeset="/data/group_summary/grp_q_menopause" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_menopause/q_menopause" readonly="true()" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_menopause/calc_q_menopause" type="string" calculate=" /data/page_3b/post_menopause_bleeding "/>
      <bind nodeset="/data/group_summary/grp_q_intercourse" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_intercourse/q_intercourse" readonly="true()" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_intercourse/calc_q_intercourse" type="string" calculate=" /data/page_3b/post_intercourse_bleeding "/>
      <bind nodeset="/data/group_summary/grp_q_discharge" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_discharge/q_discharge" readonly="true()" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/group_summary/grp_q_discharge/calc_q_discharge" type="string" calculate=" /data/page_3c/foul_smelling_vaginal_discharge "/>
      <bind nodeset="/data/group_summary/sum_hdr_d" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_q_phq1/q_phq1" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_q_phq1/calc_q_phq1" type="string" calculate=" /data/page_4_phq2/phq2_q1 "/>
      <bind nodeset="/data/group_summary/grp_q_phq2/q_phq2" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_q_phq2/calc_q_phq2" type="string" calculate=" /data/page_4_phq2/phq2_q2 "/>
      <bind nodeset="/data/group_summary/grp_q_phq_tot/q_phq_tot" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_q_phq_tot/calc_q_phq_tot" type="string" calculate=" /data/phq2_total "/>
      <bind nodeset="/data/group_summary/summary_high_risk" readonly="true()" type="string" relevant=" /data/total_score  &gt; 4"/>
      <bind nodeset="/data/group_summary/summary_low_risk" readonly="true()" type="string" relevant=" /data/total_score  &lt;= 4"/>
      <bind nodeset="/data/form_submit_timestamp" type="string" calculate="now()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/title "/>
    </model>
  </h:head>
  <h:body class="pages grid-layout">
    <group appearance="field-list" ref="/data/inputs">
      <label>Patient &amp; Reporter Info</label>
      <group ref="/data/inputs/user"/>
      <input ref="/data/inputs/reporter_name_note">
        <label> Filled by: <output value=" /data/reporter_name "/></label>
      </input>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-person role-patient">
          <label>Patient's Name</label>
          <hint>Select the patient from your area</hint>
        </input>
        <input ref="/data/inputs/contact/patient_id" appearance="hidden">
          <label>Medic ID</label>
        </input>
        <input ref="/data/inputs/contact/name" appearance="hidden">
          <label>Patient Name</label>
        </input>
        <select1 ref="/data/inputs/contact/gender">
          <label>Gender</label>
          <itemset nodeset="instance('gender')/root/item">
            <value ref="name"/>
            <label ref="label"/>
          </itemset>
        </select1>
      </group>
      <select1 ref="/data/inputs/state" appearance="minimal">
        <label>State</label>
        <itemset nodeset="instance('states')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/inputs/district" appearance="minimal">
        <label>District</label>
        <itemset nodeset="instance('districts')/root/item[filter =  /data/inputs/state ]">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <input ref="/data/instructions">
      <label>Part A consists of 6 questions. Each question carries a score. A total score above 4 indicates high risk for NCDs — such a person should be prioritised for further examination at the weekly NCD clinic.</label>
    </input>
    <group appearance="field-list" ref="/data/page_1a">
      <label>Part A: Risk Assessment (1 of 2)</label>
      <select1 ref="/data/page_1a/age_range">
        <label>1. What is your age? (in complete years)</label>
        <itemset nodeset="instance('age_range')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_1a/smoke_frequency">
        <label>2. Do you smoke or consume smokeless products such as gutka or khaini?</label>
        <itemset nodeset="instance('smoke_frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_1a/alcohol_frequency">
        <label>3. Do you consume alcohol daily</label>
        <itemset nodeset="instance('alcohol_frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_1b">
      <label>Part A: Risk Assessment (2 of 2)</label>
      <select1 ref="/data/page_1b/waist_size">
        <label>4. Measurement of waist (in cm)</label>
        <itemset nodeset="instance('waist_size')/root/item[filter =  /data/inputs/contact/gender ]">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_1b/physical_activities_frequency">
        <label>5. Do you undertake any physical activities for minimum of 150 minutes in a week?</label>
        <itemset nodeset="instance('physical_activities_frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_1b/family_medical_history">
        <label>6. Do you have a family history (any one of your parents or siblings) of high blood pressure, diabetes and heart disease?</label>
        <itemset nodeset="instance('family_medical_history')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_score">
      <label>Part A: Score Summary</label>
      <input ref="/data/page_score/score_display">
        <label> CBAC Total Score: <output value=" /data/total_score "/></label>
      </input>
      <input ref="/data/page_score/risk_display">
        <label> Risk Category: <output value=" /data/risk_category "/></label>
      </input>
      <input ref="/data/page_score/score_high_note">
        <label>Score is greater than 4. This person may be at risk for NCDs and should be prioritized for the weekly NCD day.</label>
      </input>
      <input ref="/data/page_score/score_low_note">
        <label>Score is 4 or below. This person appears to be at low risk for NCDs at this time.</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/page_3a">
      <label>Part B: Early Detection – Women only (1 of 3)</label>
      <select1 ref="/data/page_3a/breast_lump">
        <label>7. Lump in the breast</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_3a/nipple_discharge">
        <label>8. Blood stained discharge from the nipple</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_3a/breast_shape_size_change">
        <label>9. Change in shape and size of breast</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_3b">
      <label>Part B: Early Detection – Women only (2 of 3)</label>
      <select1 ref="/data/page_3b/bleeding_between_periods">
        <label>10. Bleeding between periods</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_3b/post_menopause_bleeding">
        <label>11. Bleeding after menopause</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_3b/post_intercourse_bleeding">
        <label>12. Bleeding after intercourse</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_3c">
      <label>Part B: Early Detection – Women only (3 of 3)</label>
      <select1 ref="/data/page_3c/foul_smelling_vaginal_discharge">
        <label>13. Foul smelling vaginal discharge</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_4_phq2">
      <label>Part C: PHQ 2</label>
      <input ref="/data/page_4_phq2/phq2_instructions">
        <label>Over the last 2 weeks, how often have you been bothered by the following problems?</label>
      </input>
      <select1 ref="/data/page_4_phq2/phq2_q1">
        <label>1. Little interest or pleasure in doing things?</label>
        <itemset nodeset="instance('frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_4_phq2/phq2_q2">
        <label>2. Feeling down, depressed or hopeless?</label>
        <itemset nodeset="instance('frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_4_phq2_score">
      <label>Part C: PHQ 2 Score</label>
      <input ref="/data/page_4_phq2_score/phq2_score_display">
        <label> PHQ-2 Total Score: <output value=" /data/phq2_total "/></label>
      </input>
      <input ref="/data/page_4_phq2_score/phq2_referral_note">
        <label>Anyone with total score greater than 3 should be referred to CHO/MO (PHC/UPHC)</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/group_summary">
      <label>Assessment Summary</label>
      <group appearance="field-list" ref="/data/group_summary/grp_filled_by">
        <input ref="/data/group_summary/grp_filled_by/lbl_filled_by">
          <label> **Filled by:** <output value=" /data/reporter_name "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_patient">
        <input ref="/data/group_summary/grp_patient/lbl_patient">
          <label> **Patient:** <output value=" /data/patient_name "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_gender">
        <input ref="/data/group_summary/grp_gender/lbl_gender">
          <label> **Gender:** <output value=" /data/inputs/contact/gender "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_state">
        <input ref="/data/group_summary/grp_state/lbl_state">
          <label> **State:** <output value=" /data/inputs/state "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_district">
        <input ref="/data/group_summary/grp_district/lbl_district">
          <label> **District:** <output value=" /data/inputs/district "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_score">
        <input ref="/data/group_summary/grp_score/lbl_score">
          <label> **CBAC Total Score:** <output value=" /data/total_score "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_risk">
        <input ref="/data/group_summary/grp_risk/lbl_risk">
          <label> **Risk Category:** <output value=" /data/risk_category "/></label>
        </input>
      </group>
      <input ref="/data/group_summary/sum_hdr_a">
        <label>**Part A: Risk Assessment**</label>
      </input>
      <group appearance="field-list" ref="/data/group_summary/grp_q_age">
        <input ref="/data/group_summary/grp_q_age/q_age">
          <label> 1. Age: <output value=" /data/page_1a/age_range "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_smoke">
        <input ref="/data/group_summary/grp_q_smoke/q_smoke">
          <label> 2. Smoke/Smokeless products: <output value=" /data/page_1a/smoke_frequency "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_alcohol">
        <input ref="/data/group_summary/grp_q_alcohol/q_alcohol">
          <label> 3. Alcohol daily: <output value=" /data/page_1a/alcohol_frequency "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_waist">
        <input ref="/data/group_summary/grp_q_waist/q_waist">
          <label> 4. Waist measurement: <output value=" /data/page_1b/waist_size "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_physical">
        <input ref="/data/group_summary/grp_q_physical/q_physical">
          <label> 5. Physical activity (150 min/week): <output value=" /data/page_1b/physical_activities_frequency "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_family">
        <input ref="/data/group_summary/grp_q_family/q_family">
          <label> 6. Family history of BP/Diabetes/Heart disease: <output value=" /data/page_1b/family_medical_history "/></label>
        </input>
      </group>
      <input ref="/data/group_summary/sum_hdr_b">
        <label>**Part B: Early Detection**</label>
      </input>
      <group appearance="field-list" ref="/data/group_summary/grp_q_breast_lump">
        <input ref="/data/group_summary/grp_q_breast_lump/q_breast_lump">
          <label> 7. Lump in the breast: <output value=" /data/page_3a/breast_lump "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_nipple">
        <input ref="/data/group_summary/grp_q_nipple/q_nipple">
          <label> 8. Blood stained nipple discharge: <output value=" /data/page_3a/nipple_discharge "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_breast_shape">
        <input ref="/data/group_summary/grp_q_breast_shape/q_breast_shape">
          <label> 9. Change in breast shape/size: <output value=" /data/page_3a/breast_shape_size_change "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_bleeding_periods">
        <input ref="/data/group_summary/grp_q_bleeding_periods/q_bleeding_periods">
          <label> 10. Bleeding between periods: <output value=" /data/page_3b/bleeding_between_periods "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_menopause">
        <input ref="/data/group_summary/grp_q_menopause/q_menopause">
          <label> 11. Bleeding after menopause: <output value=" /data/page_3b/post_menopause_bleeding "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_intercourse">
        <input ref="/data/group_summary/grp_q_intercourse/q_intercourse">
          <label> 12. Bleeding after intercourse: <output value=" /data/page_3b/post_intercourse_bleeding "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_discharge">
        <input ref="/data/group_summary/grp_q_discharge/q_discharge">
          <label> 13. Foul smelling vaginal discharge: <output value=" /data/page_3c/foul_smelling_vaginal_discharge "/></label>
        </input>
      </group>
      <input ref="/data/group_summary/sum_hdr_d">
        <label>**Part C: PHQ-2**</label>
      </input>
      <group appearance="field-list" ref="/data/group_summary/grp_q_phq1">
        <input ref="/data/group_summary/grp_q_phq1/q_phq1">
          <label> 1. Little interest or pleasure in doing things: <output value=" /data/page_4_phq2/phq2_q1 "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_phq2">
        <input ref="/data/group_summary/grp_q_phq2/q_phq2">
          <label> 2. Feeling down, depressed or hopeless: <output value=" /data/page_4_phq2/phq2_q2 "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_q_phq_tot">
        <input ref="/data/group_summary/grp_q_phq_tot/q_phq_tot">
          <label> PHQ-2 Total Score: <output value=" /data/phq2_total "/></label>
        </input>
      </group>
      <input ref="/data/group_summary/summary_high_risk">
        <label>**Score is greater than 4.** This person may be at risk for NCDs and should be prioritized for the weekly NCD day.</label>
      </input>
      <input ref="/data/group_summary/summary_low_risk">
        <label>**Score is 4 or below.** This person appears to be at low risk for NCDs at this time.</label>
      </input>
    </group>
  </h:body>
</h:html>