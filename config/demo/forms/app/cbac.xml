          <item>
            <name>crop_residue_burning</name>
            <label>Crop residue burning/burning of garbage – leaves</label>
          </item>
          <item>
            <name>working_in_industries</name>
            <label>Working in industries with smoke, gas and dust exposure such as brick kilns and glass factories etc.</label>
          </item>
        </root>
