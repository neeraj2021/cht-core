<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>CBAC</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="cbac" prefix="J1!cbac!" delimiter="#">
          <patient_id/>
          <patient_uuid/>
          <patient_name/>
          <reporter_name/>
          <reporter_place/>
          <title/>
          <form_start_timestamp/>
          <form_sync_timestamp/>
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <name/>
              <phone/>
            </user>
            <reporter_name_note/>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
              <gender/>
            </contact>
            <state/>
            <district/>
          </inputs>
          <total_question/>
          <instructions/>
          <page_1a>
            <age_range/>
            <smoke_frequency/>
            <alcohol_frequency/>
          </page_1a>
          <page_1b>
            <waist_size/>
            <physical_activities_frequency/>
            <family_medical_history/>
          </page_1b>
          <total_score/>
          <risk_category/>
          <page_score>
            <score_display/>
            <risk_display/>
            <score_high_note/>
            <score_low_note/>
          </page_score>
          <page_3a>
            <breast_lump/>
            <nipple_discharge/>
            <breast_shape_size_change/>
          </page_3a>
          <page_3b>
            <bleeding_between_periods/>
            <post_menopause_bleeding/>
            <post_intercourse_bleeding/>
          </page_3b>
          <page_3c>
            <foul_smelling_vaginal_discharge/>
          </page_3c>
          <page_4_phq2>
            <phq2_instructions/>
            <phq2_q1/>
            <phq2_q2/>
          </page_4_phq2>
          <phq2_total/>
          <page_4_phq2_score>
            <phq2_score_display/>
            <phq2_referral_note/>
          </page_4_phq2_score>
          <group_summary>
            <grp_filled_by>
              <lbl_filled_by/>
              <calc_reporter/>
            </grp_filled_by>
            <grp_patient>
              <lbl_patient/>
              <calc_patient/>
            </grp_patient>
            <grp_gender>
              <lbl_gender/>
              <calc_gender/>
            </grp_gender>
            <grp_state>
              <lbl_state/>
              <calc_state/>
            </grp_state>
            <grp_district>
              <lbl_district/>
              <calc_district/>
            </grp_district>
            <grp_score>
              <lbl_score/>
              <calc_score/>
            </grp_score>
            <grp_risk>
              <lbl_risk/>
              <calc_risk/>
            </grp_risk>
            <sum_hdr_a/>
            <grp_q_age>
              <q_age/>
              <calc_q_age/>
            </grp_q_age>
            <grp_q_smoke>
              <q_smoke/>
              <calc_q_smoke/>
            </grp_q_smoke>
            <grp_q_alcohol>
              <q_alcohol/>
              <calc_q_alcohol/>
            </grp_q_alcohol>
            <grp_q_waist>
              <q_waist/>
              <calc_q_waist/>
            </grp_q_waist>
            <grp_q_physical>
              <q_physical/>
              <calc_q_physical/>
            </grp_q_physical>
            <grp_q_family>
              <q_family/>
              <calc_q_family/>
            </grp_q_family>
            <sum_hdr_b/>
            <grp_q_breast_lump>
              <q_breast_lump/>
              <calc_q_breast_lump/>
            </grp_q_breast_lump>
            <grp_q_nipple>
              <q_nipple/>
              <calc_q_nipple/>
            </grp_q_nipple>
            <grp_q_breast_shape>
              <q_breast_shape/>
              <calc_q_breast_shape/>
            </grp_q_breast_shape>
            <grp_q_bleeding_periods>
              <q_bleeding_periods/>
              <calc_q_bleeding_periods/>
            </grp_q_bleeding_periods>
            <grp_q_menopause>
              <q_menopause/>
              <calc_q_menopause/>
            </grp_q_menopause>
            <grp_q_intercourse>
              <q_intercourse/>
              <calc_q_intercourse/>
            </grp_q_intercourse>
            <grp_q_discharge>
              <q_discharge/>
              <calc_q_discharge/>
            </grp_q_discharge>
            <sum_hdr_d/>
            <grp_q_phq1>
              <q_phq1/>
              <calc_q_phq1/>
            </grp_q_phq1>
            <grp_q_phq2>
              <q_phq2/>
              <calc_q_phq2/>
            </grp_q_phq2>
            <grp_q_phq_tot>
              <q_phq_tot/>
              <calc_q_phq_tot/>
            </grp_q_phq_tot>
            <summary_high_risk/>
            <summary_low_risk/>
          </group_summary>
          <form_submit_timestamp/>
          <meta tag="hidden">
            <instanceID/>
            <instanceName/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="frequency">
