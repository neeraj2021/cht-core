<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>CBAC</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="cbac" prefix="J1!cbac!" delimiter="#">
          <patient_id/>
          <patient_uuid/>
          <patient_name/>
          <reporter_name/>
          <reporter_place/>
          <title/>
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <name/>
              <phone/>
            </user>
            <reporter_name_note/>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
              <gender/>
            </contact>
            <state/>
            <district/>
          </inputs>
          <instructions/>
          <total_question/>
          <page_1a>
            <age_range/>
            <smoke_frequency/>
            <alcohol_frequency/>
          </page_1a>
          <page_1b>
            <waist_size/>
            <physical_activities_frequency/>
            <family_medical_history/>
          </page_1b>
          <total_score/>
          <risk_category/>
          <page_score>
            <score_display/>
            <risk_display/>
            <score_high_note/>
            <score_low_note/>
          </page_score>
          <page_2a>
            <shortness_of_breath/>
            <cough_more_than_2_weeks/>
            <blood_in_sputum/>
          </page_2a>
          <page_2b>
            <fever_more_than_2_weeks/>
            <loss_of_weight/>
            <night_sweats/>
          </page_2b>
          <page_2c>
            <current_anti_tb_drug/>
            <family_tb/>
            <history_of_tb/>
          </page_2c>
          <page_2d>
            <history_of_fits/>
            <difficulty_opening_mouth/>
            <mouth_ulcers_or_growth/>
          </page_2d>
          <page_2e>
            <voice_change/>
            <skin_patch_discoloration/>
            <difficulty_holding_objects/>
          </page_2e>
          <page_2f>
            <loss_of_sensation/>
          </page_2f>
          <page_3a>
            <breast_lump/>
            <nipple_discharge/>
            <breast_shape_size_change/>
          </page_3a>
          <page_3b>
            <bleeding_between_periods/>
            <post_menopause_bleeding/>
            <post_intercourse_bleeding/>
          </page_3b>
          <page_3c>
            <foul_smelling_vaginal_discharge/>
          </page_3c>
          <part_c_start_q/>
          <part_c_q2/>
          <page_4>
            <fuel_type_for_cooking/>
            <occupational_exposure/>
          </page_4>
          <group_summary>
            <summary_high_risk/>
            <summary_low_risk/>
            <lbl_filled_by/>
            <lbl_patient_val/>
            <lbl_gender_val/>
            <lbl_state_val/>
            <lbl_district_val/>
            <lbl_score_val/>
            <lbl_risk_val/>
          </group_summary>
          <meta tag="hidden">
            <instanceID/>
            <instanceName/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="frequency">
        <root>
          <item>
            <name>0</name>
            <label>Not at all</label>
          </item>
          <item>
            <name>1</name>
            <label>Several days</label>
          </item>
          <item>
            <name>2</name>
            <label>More than half the days</label>
          </item>
          <item>
            <name>3</name>
            <label>Nearly every day</label>
          </item>
        </root>
      </instance>
      <instance id="states">
        <root>
          <item>
            <name>kerala</name>
            <label>Kerala</label>
          </item>
          <item>
            <name>tamil_nadu</name>
            <label>Tamil Nadu</label>
          </item>
          <item>
            <name>andhra_pradesh</name>
            <label>Andhra Pradesh</label>
          </item>
          <item>
            <name>telangana</name>
            <label>Telangana</label>
          </item>
          <item>
            <name>karnataka</name>
            <label>Karnataka</label>
          </item>
        </root>
      </instance>
      <instance id="districts">
        <root>
          <item>
            <name>chennai</name>
            <label>Chennai</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>thanjavur</name>
            <label>Thanjavur</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>coimbatore</name>
            <label>Coimbatore</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>madurai</name>
            <label>Madurai</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>salem</name>
            <label>Salem</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>tiruchirappalli</name>
            <label>Tiruchirappalli</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>thiruvananthapuram</name>
            <label>Thiruvananthapuram</label>
            <filter>kerala</filter>
          </item>
          <item>
            <name>kochi</name>
            <label>Kochi</label>
            <filter>kerala</filter>
          </item>
          <item>
            <name>kozhikode</name>
            <label>Kozhikode</label>
            <filter>kerala</filter>
          </item>
          <item>
            <name>thrissur</name>
            <label>Thrissur</label>
            <filter>kerala</filter>
          </item>
          <item>
            <name>kollam</name>
            <label>Kollam</label>
            <filter>kerala</filter>
          </item>
          <item>
            <name>visakhapatnam</name>
            <label>Visakhapatnam</label>
            <filter>andhra_pradesh</filter>
          </item>
          <item>
            <name>vijayawada</name>
            <label>Vijayawada</label>
            <filter>andhra_pradesh</filter>
          </item>
          <item>
            <name>guntur</name>
            <label>Guntur</label>
            <filter>andhra_pradesh</filter>
          </item>
          <item>
            <name>tirupati</name>
            <label>Tirupati</label>
            <filter>andhra_pradesh</filter>
          </item>
          <item>
            <name>kurnool</name>
            <label>Kurnool</label>
            <filter>andhra_pradesh</filter>
          </item>
          <item>
            <name>hyderabad</name>
            <label>Hyderabad</label>
            <filter>telangana</filter>
          </item>
          <item>
            <name>warangal</name>
            <label>Warangal</label>
            <filter>telangana</filter>
          </item>
          <item>
            <name>nizamabad</name>
            <label>Nizamabad</label>
            <filter>telangana</filter>
          </item>
          <item>
            <name>karimnagar</name>
            <label>Karimnagar</label>
            <filter>telangana</filter>
          </item>
          <item>
            <name>khammam</name>
            <label>Khammam</label>
            <filter>telangana</filter>
          </item>
          <item>
            <name>bengaluru</name>
            <label>Bengaluru</label>
            <filter>karnataka</filter>
          </item>
          <item>
            <name>mysuru</name>
            <label>Mysuru</label>
            <filter>karnataka</filter>
          </item>
          <item>
            <name>hubli</name>
            <label>Hubli</label>
            <filter>karnataka</filter>
          </item>
          <item>
            <name>mangaluru</name>
            <label>Mangaluru</label>
            <filter>karnataka</filter>
          </item>
          <item>
            <name>belagavi</name>
            <label>Belagavi</label>
            <filter>karnataka</filter>
          </item>
        </root>
      </instance>
      <instance id="smoke_frequency">
        <root>
          <item>
            <name>0</name>
            <label>Never</label>
          </item>
          <item>
            <name>1</name>
            <label>Used to consume in the past/ Sometimes now</label>
          </item>
          <item>
            <name>2</name>
            <label>Daily</label>
          </item>
        </root>
      </instance>
      <instance id="age_range">
        <root>
          <item>
            <name>0</name>
            <label>30-39 years</label>
          </item>
          <item>
            <name>1</name>
            <label>40-49 years</label>
          </item>
          <item>
            <name>2</name>
            <label>≥ 50 years</label>
          </item>
        </root>
      </instance>
      <instance id="alcohol_frequency">
        <root>
          <item>
            <name>0</name>
            <label>No</label>
          </item>
          <item>
            <name>1</name>
            <label>Yes</label>
          </item>
        </root>
      </instance>
      <instance id="physical_activities_frequency">
        <root>
          <item>
            <name>0</name>
            <label>At least 150 minutes in a week</label>
          </item>
          <item>
            <name>1</name>
            <label>Less than 150 minutes in a week</label>
          </item>
        </root>
      </instance>
      <instance id="family_medical_history">
        <root>
          <item>
            <name>0</name>
            <label>No</label>
          </item>
          <item>
            <name>2</name>
            <label>Yes</label>
          </item>
        </root>
      </instance>
      <instance id="waist_size">
        <root>
          <item>
            <name>0</name>
            <label>80 cm or less</label>
            <filter>female</filter>
          </item>
          <item>
            <name>0</name>
            <label>90 cm or less</label>
            <filter>male</filter>
          </item>
          <item>
            <name>1</name>
            <label>81-90 cm</label>
            <filter>female</filter>
          </item>
          <item>
            <name>1</name>
            <label>91-100 cm</label>
            <filter>male</filter>
          </item>
          <item>
            <name>2</name>
            <label>More than 90 cm</label>
            <filter>female</filter>
          </item>
          <item>
            <name>2</name>
            <label>More than 100 cm</label>
            <filter>male</filter>
          </item>
        </root>
      </instance>
      <instance id="gender">
        <root>
          <item>
            <name>male</name>
            <label>Male</label>
          </item>
          <item>
            <name>female</name>
            <label>Female</label>
          </item>
        </root>
      </instance>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="fuel_type">
        <root>
          <item>
            <name>firewood</name>
            <label>Firewood</label>
          </item>
          <item>
            <name>crop_residue</name>
            <label>Crop Residue</label>
          </item>
          <item>
            <name>cow_dung_cake</name>
            <label>Cow dung cake</label>
          </item>
          <item>
            <name>coal</name>
            <label>Coal</label>
          </item>
          <item>
            <name>kerosene</name>
            <label>Kerosene</label>
          </item>
        </root>
      </instance>
      <instance id="occupational_exposure">
        <root>
          <item>
            <name>crop_residue_burning</name>
            <label>Crop residue burning/burning of garbage – leaves</label>
          </item>
          <item>
            <name>working_in_industries</name>
            <label>Working in industries with smoke, gas and dust exposure such as brick kilns and glass factories etc.</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/patient_id" type="string" calculate="../inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/reporter_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/reporter_place" type="string" calculate="instance('user-contact-summary')/context/facility_name"/>
      <bind nodeset="/data/title" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/user/phone" type="string"/>
      <bind nodeset="/data/inputs/reporter_name_note" readonly="true()" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="string" required="true()"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/gender" type="string" required="true()"/>
      <bind nodeset="/data/inputs/state" type="string" required="true()"/>
      <bind nodeset="/data/inputs/district" type="string" required="true()"/>
      <bind nodeset="/data/instructions" readonly="true()" type="string"/>
      <bind nodeset="/data/total_question" type="string" calculate="if( /data/inputs/contact/gender  = 'male', '22', '29')"/>
      <bind nodeset="/data/page_1a/age_range" type="string" required="true()"/>
      <bind nodeset="/data/page_1a/smoke_frequency" type="string" required="true()"/>
      <bind nodeset="/data/page_1a/alcohol_frequency" type="string" required="true()"/>
      <bind nodeset="/data/page_1b/waist_size" type="string" required="true()"/>
      <bind nodeset="/data/page_1b/physical_activities_frequency" type="string" required="true()"/>
      <bind nodeset="/data/page_1b/family_medical_history" type="string" required="true()"/>
      <bind nodeset="/data/total_score" type="string" calculate=" /data/page_1a/age_range  +  /data/page_1a/smoke_frequency  +  /data/page_1a/alcohol_frequency  +  /data/page_1b/waist_size  +  /data/page_1b/physical_activities_frequency  +  /data/page_1b/family_medical_history "/>
      <bind nodeset="/data/risk_category" type="string" calculate="if( /data/total_score  &gt; 4, 'High Risk', 'Low Risk')"/>
      <bind nodeset="/data/page_score/score_display" readonly="true()" type="string"/>
      <bind nodeset="/data/page_score/risk_display" readonly="true()" type="string"/>
      <bind nodeset="/data/page_score/score_high_note" readonly="true()" type="string" relevant=" /data/total_score  &gt; 4"/>
      <bind nodeset="/data/page_score/score_low_note" readonly="true()" type="string" relevant=" /data/total_score  &lt;= 4"/>
      <bind nodeset="/data/page_2a/shortness_of_breath" type="string"/>
      <bind nodeset="/data/page_2a/cough_more_than_2_weeks" type="string"/>
      <bind nodeset="/data/page_2a/blood_in_sputum" type="string"/>
      <bind nodeset="/data/page_2b/fever_more_than_2_weeks" type="string"/>
      <bind nodeset="/data/page_2b/loss_of_weight" type="string"/>
      <bind nodeset="/data/page_2b/night_sweats" type="string"/>
      <bind nodeset="/data/page_2c/current_anti_tb_drug" type="string"/>
      <bind nodeset="/data/page_2c/family_tb" type="string"/>
      <bind nodeset="/data/page_2c/history_of_tb" type="string"/>
      <bind nodeset="/data/page_2d/history_of_fits" type="string"/>
      <bind nodeset="/data/page_2d/difficulty_opening_mouth" type="string"/>
      <bind nodeset="/data/page_2d/mouth_ulcers_or_growth" type="string"/>
      <bind nodeset="/data/page_2e/voice_change" type="string"/>
      <bind nodeset="/data/page_2e/skin_patch_discoloration" type="string"/>
      <bind nodeset="/data/page_2e/difficulty_holding_objects" type="string"/>
      <bind nodeset="/data/page_2f/loss_of_sensation" type="string"/>
      <bind nodeset="/data/page_3a" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3a/breast_lump" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3a/nipple_discharge" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3a/breast_shape_size_change" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3b" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3b/bleeding_between_periods" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3b/post_menopause_bleeding" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3b/post_intercourse_bleeding" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3c" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/page_3c/foul_smelling_vaginal_discharge" type="string" relevant=" /data/inputs/contact/gender  = 'female'"/>
      <bind nodeset="/data/part_c_start_q" type="string" calculate="if( /data/inputs/contact/gender  = 'male', 23, 30)"/>
      <bind nodeset="/data/part_c_q2" type="string" calculate="if( /data/inputs/contact/gender  = 'male', 24, 31)"/>
      <bind nodeset="/data/page_4/fuel_type_for_cooking" type="string"/>
      <bind nodeset="/data/page_4/occupational_exposure" type="string"/>
      <bind nodeset="/data/group_summary/summary_high_risk" readonly="true()" type="string" relevant=" /data/total_score  &gt; 4"/>
      <bind nodeset="/data/group_summary/summary_low_risk" readonly="true()" type="string" relevant=" /data/total_score  &lt;= 4"/>
      <bind nodeset="/data/group_summary/lbl_filled_by" readonly="true()" type="string" calculate=" /data/reporter_name "/>
      <bind nodeset="/data/group_summary/lbl_patient_val" readonly="true()" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/group_summary/lbl_gender_val" readonly="true()" type="string" calculate=" /data/inputs/contact/gender "/>
      <bind nodeset="/data/group_summary/lbl_state_val" readonly="true()" type="string" calculate=" /data/inputs/state "/>
      <bind nodeset="/data/group_summary/lbl_district_val" readonly="true()" type="string" calculate=" /data/inputs/district "/>
      <bind nodeset="/data/group_summary/lbl_score_val" readonly="true()" type="string" calculate=" /data/total_score "/>
      <bind nodeset="/data/group_summary/lbl_risk_val" readonly="true()" type="string" calculate=" /data/risk_category "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/title "/>
    </model>
  </h:head>
  <h:body class="pages grid-layout">
    <group appearance="field-list" ref="/data/inputs">
      <label>Patient &amp; Reporter Info</label>
      <group ref="/data/inputs/user"/>
      <input ref="/data/inputs/reporter_name_note">
        <label> Filled by: <output value=" /data/reporter_name "/></label>
      </input>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-person role-patient">
          <label>Patient's Name</label>
          <hint>Select the patient from your area</hint>
        </input>
        <input ref="/data/inputs/contact/patient_id" appearance="hidden">
          <label>Medic ID</label>
        </input>
        <input ref="/data/inputs/contact/name" appearance="hidden">
          <label>Patient Name</label>
        </input>
        <select1 ref="/data/inputs/contact/gender">
          <label>Gender</label>
          <itemset nodeset="instance('gender')/root/item">
            <value ref="name"/>
            <label ref="label"/>
          </itemset>
        </select1>
      </group>
      <select1 ref="/data/inputs/state" appearance="minimal">
        <label>State</label>
        <itemset nodeset="instance('states')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/inputs/district" appearance="minimal">
        <label>District</label>
        <itemset nodeset="instance('districts')/root/item[filter =  /data/inputs/state ]">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <input ref="/data/instructions">
      <label>A score above 4 indicates that the person may be at risk for these NCDs and needs to be prioritized for attending the weekly NCD day</label>
    </input>
    <group appearance="field-list" ref="/data/page_1a">
      <label>Part A: Risk Assessment (1 of 2)</label>
      <select1 ref="/data/page_1a/age_range">
        <label>1. What is your age? (in complete years)</label>
        <itemset nodeset="instance('age_range')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_1a/smoke_frequency">
        <label>2. Do you smoke or consume smokeless products such as gutka or khaini?</label>
        <itemset nodeset="instance('smoke_frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_1a/alcohol_frequency">
        <label>3. Do you consume alcohol daily</label>
        <itemset nodeset="instance('alcohol_frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_1b">
      <label>Part A: Risk Assessment (2 of 2)</label>
      <select1 ref="/data/page_1b/waist_size">
        <label>4. Measurement of waist (in cm)</label>
        <itemset nodeset="instance('waist_size')/root/item[filter =  /data/inputs/contact/gender ]">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_1b/physical_activities_frequency">
        <label>5. Do you undertake any physical activities for minimum of 150 minutes in a week?</label>
        <itemset nodeset="instance('physical_activities_frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_1b/family_medical_history">
        <label>6. Do you have a family history (any one of your parents or siblings) of high blood pressure, diabetes and heart disease?</label>
        <itemset nodeset="instance('family_medical_history')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_score">
      <label>Part A: Score Summary</label>
      <input ref="/data/page_score/score_display">
        <label> CBAC Total Score: <output value=" /data/total_score "/></label>
      </input>
      <input ref="/data/page_score/risk_display">
        <label> Risk Category: <output value=" /data/risk_category "/></label>
      </input>
      <input ref="/data/page_score/score_high_note">
        <label>Score is greater than 4. This person may be at risk for NCDs and should be prioritized for the weekly NCD day.</label>
      </input>
      <input ref="/data/page_score/score_low_note">
        <label>Score is 4 or below. This person appears to be at low risk for NCDs at this time.</label>
      </input>
