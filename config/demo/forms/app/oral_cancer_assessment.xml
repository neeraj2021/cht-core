      <bind nodeset="/data/group_summary/grp_lbl_photo_4" relevant=" /data/all_habits_never  = 'no'"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_4/lbl_photo_4_suspicion" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_4/calc_photo_4_suspicion_lbl" type="string" calculate="jr:choice-name( /data/photo_4_page/ai_photo_4_suspicion ,' /data/photo_4_page/ai_photo_4_suspicion ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_5" relevant=" /data/all_habits_never  = 'no'"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_5/lbl_photo_5_suspicion" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_5/calc_photo_5_suspicion_lbl" type="string" calculate="jr:choice-name( /data/photo_5_page/ai_photo_5_suspicion ,' /data/photo_5_page/ai_photo_5_suspicion ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_6" relevant=" /data/all_habits_never  = 'no'"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_6/lbl_photo_6_suspicion" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_6/calc_photo_6_suspicion_lbl" type="string" calculate="jr:choice-name( /data/photo_6_page/ai_photo_6_suspicion ,' /data/photo_6_page/ai_photo_6_suspicion ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_7" relevant=" /data/all_habits_never  = 'no'"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_7/lbl_photo_7_suspicion" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_7/calc_photo_7_suspicion_lbl" type="string" calculate="jr:choice-name( /data/photo_7_page/ai_photo_7_suspicion ,' /data/photo_7_page/ai_photo_7_suspicion ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_8" relevant=" /data/all_habits_never  = 'no'"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_8/lbl_photo_8_suspicion" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_photo_8/calc_photo_8_suspicion_lbl" type="string" calculate="jr:choice-name( /data/photo_8_page/ai_photo_8_suspicion ,' /data/photo_8_page/ai_photo_8_suspicion ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_final_suspicion" relevant=" /data/all_habits_never  = 'no'"/>
      <bind nodeset="/data/group_summary/grp_lbl_final_suspicion/lbl_final_suspicion" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_final_suspicion/calc_final_suspicion_lbl" type="string" calculate=" /data/final_ai_analysis_page/final_ai_suspicion "/>
      <bind nodeset="/data/group_summary/grp_lbl_final_referral" relevant=" /data/all_habits_never  = 'no' and ( /data/final_ai_analysis_page/final_ai_suspicion  = 'non_suspicious' or  /data/final_ai_analysis_page/final_ai_suspicion  = 'suspicious')"/>
      <bind nodeset="/data/group_summary/grp_lbl_final_referral/lbl_final_referral" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_final_referral/calc_final_referral_lbl" type="string" calculate="jr:choice-name( /data/final_ai_analysis_page/final_ai_referral ,' /data/final_ai_analysis_page/final_ai_referral ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_habit_status/lbl_habit_status" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_habit_status/calc_habit_status_lbl" type="string" calculate="if( /data/all_habits_never  = 'yes','As per Habit History, nothing suspicious is found. So no need of Oral Visual Examination ','Patient has habit history. Photos are captured for Oral Exam.')"/>
      <bind nodeset="/data/group_summary/ai_analysis_summary" type="string"/>
      <bind nodeset="/data/group_summary/ai_analysis_status" type="string"/>
      <bind nodeset="/data/group_summary/ai_analysis_error" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/title "/>
    </model>
  </h:head>
  <h:body class="pages grid-layout">
    <group appearance="field-list" ref="/data/oral_intro_page">
      <label>Oral Cancer Screening</label>
      <input ref="/data/oral_intro_page/oral_intro_note">
        <label>You will now ask questions and if needed take 8 photos of the oral cavity.</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/inputs">
      <label>Patient &amp; Reporter Info</label>
      <group ref="/data/inputs/user"/>
      <input ref="/data/inputs/reporter_name_note">
        <label> Filled by: <output value=" /data/reporter_name "/></label>
      </input>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-patient role-patient">
          <label>Patient's Name</label>
          <hint>Select the patient from your area</hint>
        </input>
        <input ref="/data/inputs/contact/patient_id" appearance="hidden">
          <label>Medic ID</label>
        </input>
        <input ref="/data/inputs/contact/name" appearance="hidden">
          <label>Patient Name</label>
        </input>
      </group>
      <select1 ref="/data/inputs/state" appearance="minimal">
        <label>State</label>
        <itemset nodeset="instance('states')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/inputs/district" appearance="minimal">
        <label>District</label>
        <itemset nodeset="instance('districts')/root/item[filter =  /data/inputs/state ]">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/habit_history">
      <label>Habit history</label>
      <select1 ref="/data/habit_history/cigarette_bidi">
        <label>Cigarette / Bidi</label>
        <itemset nodeset="instance('history_status')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/habit_history/smokeless_tobacco">
        <label>Smokeless Tobacco</label>
        <itemset nodeset="instance('history_status')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/habit_history/areca_nut">
        <label>Areca Nut</label>
        <itemset nodeset="instance('history_status')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/habit_history/alcohol">
        <label>Alcohol</label>
        <itemset nodeset="instance('history_status')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/habit_history/alcohol_frequency">
        <label>Alcohol frequency (days per week)</label>
        <hint>Enter a whole number from 0 to 7</hint>
      </input>
    </group>
    <group appearance="field-list" ref="/data/photo_no_intro_page">
      <label>No Oral Visual Exam</label>
      <input ref="/data/photo_no_intro_page/photo_no_intro_note">
        <label>No oral cancer risk detected based on habit history. Oral Visual Exam Not Needed.</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/photo_intro_page">
      <label>Oral Photo Instructions</label>
      <input ref="/data/photo_intro_page/photo_intro_note">
        <label ref="jr:itext('/data/photo_intro_page/photo_intro_note:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/photo_1_page">
      <upload ref="/data/photo_1_page/photo_1" mediatype="image/*">
        <label>Photo 1 / 8</label>
      </upload>
      <select1 ref="/data/photo_1_page/ai_photo_1_suspicion">
        <label>Photo 1 Health Worker Observation</label>
        <itemset nodeset="instance('suspicion')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/photo_2_page">
      <upload ref="/data/photo_2_page/photo_2" mediatype="image/*">
        <label>Photo 2 / 8</label>
      </upload>
      <select1 ref="/data/photo_2_page/ai_photo_2_suspicion">
        <label>Photo 2 Health Worker Observation</label>
        <itemset nodeset="instance('suspicion')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/photo_3_page">
      <upload ref="/data/photo_3_page/photo_3" mediatype="image/*">
        <label>Photo 3 / 8</label>
      </upload>
      <select1 ref="/data/photo_3_page/ai_photo_3_suspicion">
        <label>Photo 3 Health Worker Observation</label>
        <itemset nodeset="instance('suspicion')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/photo_4_page">
      <upload ref="/data/photo_4_page/photo_4" mediatype="image/*">
        <label>Photo 4 / 8</label>
      </upload>
      <select1 ref="/data/photo_4_page/ai_photo_4_suspicion">
        <label>Photo 4 Health Worker Observation</label>
        <itemset nodeset="instance('suspicion')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/photo_5_page">
      <upload ref="/data/photo_5_page/photo_5" mediatype="image/*">
        <label>Photo 5 / 8</label>
      </upload>
      <select1 ref="/data/photo_5_page/ai_photo_5_suspicion">
        <label>Photo 5 Health Worker Observation</label>
        <itemset nodeset="instance('suspicion')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/photo_6_page">
      <upload ref="/data/photo_6_page/photo_6" mediatype="image/*">
        <label>Photo 6 / 8</label>
      </upload>
      <select1 ref="/data/photo_6_page/ai_photo_6_suspicion">
        <label>Photo 6 Health Worker Observation</label>
        <itemset nodeset="instance('suspicion')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/photo_7_page">
      <upload ref="/data/photo_7_page/photo_7" mediatype="image/*">
        <label>Photo 7 / 8</label>
      </upload>
      <select1 ref="/data/photo_7_page/ai_photo_7_suspicion">
        <label>Photo 7 Health Worker Observation</label>
        <itemset nodeset="instance('suspicion')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/photo_8_page">
      <upload ref="/data/photo_8_page/photo_8" mediatype="image/*">
        <label>Photo 8 / 8</label>
      </upload>
      <select1 ref="/data/photo_8_page/ai_photo_8_suspicion">
        <label>Photo 8 Health Worker Observation</label>
        <itemset nodeset="instance('suspicion')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/final_ai_analysis_page">
      <input ref="/data/final_ai_analysis_page/final_ai_suspicion">
        <label>Final AI Recommendation</label>
      </input>
      <select1 ref="/data/final_ai_analysis_page/final_ai_referral">
        <label>Referral Decision</label>
        <hint>Please tell the client to consult a dentist as soon as possible. Provide all necessary instructions to reach the dentist's facility.</hint>
        <itemset nodeset="instance('referral')/root/item[suspicion_type =  /data/final_ai_analysis_page/final_ai_suspicion ]">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/group_summary">
      <label>Assessment Summary for Oral Cancer Assessment</label>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_filled_by">
        <input ref="/data/group_summary/grp_lbl_filled_by/lbl_filled_by">
          <label> **Filled by:** <output value=" /data/reporter_name "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_patient">
        <input ref="/data/group_summary/grp_lbl_patient/lbl_patient">
          <label> **Patient:** <output value=" /data/patient_name "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_state">
        <input ref="/data/group_summary/grp_lbl_state/lbl_state">
          <label> **State:** <output value=" /data/group_summary/grp_lbl_state/calc_state_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_district">
        <input ref="/data/group_summary/grp_lbl_district/lbl_district">
          <label> **District:** <output value=" /data/group_summary/grp_lbl_district/calc_district_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_age">
        <input ref="/data/group_summary/grp_lbl_age/lbl_age">
          <label> **Age:** <output value=" /data/group_summary/grp_lbl_age/calc_age_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_gender">
        <input ref="/data/group_summary/grp_lbl_gender/lbl_gender">
          <label> **Gender:** <output value=" /data/group_summary/grp_lbl_gender/calc_gender_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_hh_q1">
        <input ref="/data/group_summary/grp_lbl_hh_q1/lbl_hh_q1">
          <label> **1. Cigarette / Bidi:** <output value=" /data/group_summary/grp_lbl_hh_q1/calc_cigarette_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_hh_q2">
        <input ref="/data/group_summary/grp_lbl_hh_q2/lbl_hh_q2">
          <label> **2. Smokeless Tobacco:** <output value=" /data/group_summary/grp_lbl_hh_q2/calc_smokeless_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_hh_q3">
        <input ref="/data/group_summary/grp_lbl_hh_q3/lbl_hh_q3">
          <label> **3. Areca Nut:** <output value=" /data/group_summary/grp_lbl_hh_q3/calc_areca_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_hh_q4">
        <input ref="/data/group_summary/grp_lbl_hh_q4/lbl_hh_q4">
          <label> **4. Alcohol:** <output value=" /data/group_summary/grp_lbl_hh_q4/calc_alcohol_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_hh_q5">
        <input ref="/data/group_summary/grp_lbl_hh_q5/lbl_hh_q5">
          <label> **5. Alcohol Frequency (days/week):** <output value=" /data/habit_history/alcohol_frequency "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_photo_1">
        <input ref="/data/group_summary/grp_lbl_photo_1/lbl_photo_1_suspicion">
          <label> **Photo 1 Health Worker Observation:** <output value=" /data/group_summary/grp_lbl_photo_1/calc_photo_1_suspicion_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_photo_2">
        <input ref="/data/group_summary/grp_lbl_photo_2/lbl_photo_2_suspicion">
          <label> **Photo 2 Health Worker Observation:** <output value=" /data/group_summary/grp_lbl_photo_2/calc_photo_2_suspicion_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_photo_3">
        <input ref="/data/group_summary/grp_lbl_photo_3/lbl_photo_3_suspicion">
          <label> **Photo 3 Health Worker Observation:** <output value=" /data/group_summary/grp_lbl_photo_3/calc_photo_3_suspicion_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_photo_4">
        <input ref="/data/group_summary/grp_lbl_photo_4/lbl_photo_4_suspicion">
          <label> **Photo 4 Health Worker Observation:** <output value=" /data/group_summary/grp_lbl_photo_4/calc_photo_4_suspicion_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_photo_5">
        <input ref="/data/group_summary/grp_lbl_photo_5/lbl_photo_5_suspicion">
          <label> **Photo 5 Health Worker Observation:** <output value=" /data/group_summary/grp_lbl_photo_5/calc_photo_5_suspicion_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_photo_6">
        <input ref="/data/group_summary/grp_lbl_photo_6/lbl_photo_6_suspicion">
          <label> **Photo 6 Health Worker Observation:** <output value=" /data/group_summary/grp_lbl_photo_6/calc_photo_6_suspicion_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_photo_7">
        <input ref="/data/group_summary/grp_lbl_photo_7/lbl_photo_7_suspicion">
          <label> **Photo 7 Health Worker Observation:** <output value=" /data/group_summary/grp_lbl_photo_7/calc_photo_7_suspicion_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_photo_8">
        <input ref="/data/group_summary/grp_lbl_photo_8/lbl_photo_8_suspicion">
          <label> **Photo 8 Health Worker Observation:** <output value=" /data/group_summary/grp_lbl_photo_8/calc_photo_8_suspicion_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_final_suspicion">
        <input ref="/data/group_summary/grp_lbl_final_suspicion/lbl_final_suspicion">
          <label> **Final AI Recommendation:** <output value=" /data/group_summary/grp_lbl_final_suspicion/calc_final_suspicion_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_final_referral">
        <input ref="/data/group_summary/grp_lbl_final_referral/lbl_final_referral">
          <label> **Referral Decision:** <output value=" /data/group_summary/grp_lbl_final_referral/calc_final_referral_lbl "/></label>
        </input>
      </group>
      <group appearance="field-list" ref="/data/group_summary/grp_lbl_habit_status">
        <input ref="/data/group_summary/grp_lbl_habit_status/lbl_habit_status">
          <label> **Habit Status:** <output value=" /data/group_summary/grp_lbl_habit_status/calc_habit_status_lbl "/></label>
        </input>
      </group>
      <input ref="/data/group_summary/ai_analysis_summary" appearance="multiline hidden">
        <label>Summary</label>
      </input>
      <input ref="/data/group_summary/ai_analysis_status" appearance="hidden">
        <label>Analysis Status</label>
      </input>
      <input ref="/data/group_summary/ai_analysis_error" appearance="hidden">
        <label>Error (if any)</label>
      </input>
    </group>
  </h:body>
</h:html>