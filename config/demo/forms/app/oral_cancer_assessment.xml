      <bind nodeset="/data/photo_4_page/ai_photo_4_label" type="string"/>
      <bind nodeset="/data/photo_4_page/ai_photo_4_score" type="string"/>
      <bind nodeset="/data/photo_4_page/ai_photo_4_suspicion" type="string" required="true()"/>
      <bind nodeset="/data/photo_5_page/photo_5" type="binary" required="true()"/>
      <bind nodeset="/data/photo_5_page/ai_photo_5_label" type="string"/>
      <bind nodeset="/data/photo_5_page/ai_photo_5_score" type="string"/>
      <bind nodeset="/data/photo_5_page/ai_photo_5_suspicion" type="string" required="true()"/>
      <bind nodeset="/data/photo_6_page/photo_6" type="binary" required="true()"/>
      <bind nodeset="/data/photo_6_page/ai_photo_6_label" type="string"/>
      <bind nodeset="/data/photo_6_page/ai_photo_6_score" type="string"/>
