<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>PHQ-9</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="phq9" prefix="J1!phq9!" delimiter="#">
          <patient_id/>
          <patient_uuid/>
          <patient_name/>
          <reporter_name/>
          <reporter_place/>
          <title/>
          <page_info>
            <lbl_about_phq9/>
          </page_info>
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source/>
            <source_id/>
            <user>
              <name/>
              <phone/>
            </user>
            <reporter_name_note/>
            <contact>
              <_id/>
              <patient_id/>
              <name/>
            </contact>
            <state/>
            <district/>
          </inputs>
          <instructions>
            <instructions_1/>
            <Instructions_2/>
            <Instructions_3/>
            <Instructions_4/>
            <Instructions_5/>
            <Instructions_6/>
          </instructions>
          <page_1>
            <little_interest_or_pleasure/>
            <feeling_depressed_or_hopeless/>
          </page_1>
          <page_2>
            <trouble_sleeping/>
            <feeling_tired/>
          </page_2>
          <page_3>
            <poor_appetite_or_overeating/>
            <feeling_bad_about_yourself/>
          </page_3>
          <page_4>
            <trouble_concentrating/>
            <moving_or_speaking_slowly/>
          </page_4>
          <page_5>
            <thoughts_of_self_harm/>
          </page_5>
          <total_score/>
          <severity_category/>
          <group_summary>
            <grp_lbl_filled_by>
              <lbl_filled_by_lbl/>
              <calc_reporter_name/>
            </grp_lbl_filled_by>
            <grp_lbl_patient>
              <lbl_patient_lbl/>
              <calc_patient_name/>
            </grp_lbl_patient>
            <grp_lbl_state>
              <lbl_state_lbl/>
              <calc_state/>
            </grp_lbl_state>
            <grp_lbl_district>
              <lbl_district_lbl/>
              <calc_district/>
            </grp_lbl_district>
            <grp_lbl_q1>
              <lbl_q1_lbl/>
              <calc_q1/>
            </grp_lbl_q1>
            <grp_lbl_q2>
              <lbl_q2_lbl/>
              <calc_q2/>
            </grp_lbl_q2>
            <grp_lbl_q3>
              <lbl_q3_lbl/>
              <calc_q3/>
            </grp_lbl_q3>
            <grp_lbl_q4>
              <lbl_q4_lbl/>
              <calc_q4/>
            </grp_lbl_q4>
            <grp_lbl_q5>
              <lbl_q5_lbl/>
              <calc_q5/>
            </grp_lbl_q5>
            <grp_lbl_q6>
              <lbl_q6_lbl/>
              <calc_q6/>
            </grp_lbl_q6>
            <grp_lbl_q7>
              <lbl_q7_lbl/>
              <calc_q7/>
            </grp_lbl_q7>
            <grp_lbl_q8>
              <lbl_q8_lbl/>
              <calc_q8/>
            </grp_lbl_q8>
            <grp_lbl_q9>
              <lbl_q9_lbl/>
              <calc_q9/>
            </grp_lbl_q9>
            <grp_lbl_score>
              <lbl_score_lbl/>
              <calc_total_score/>
            </grp_lbl_score>
            <grp_lbl_severity>
              <lbl_severity_lbl/>
              <calc_severity_category/>
            </grp_lbl_severity>
            <severity_guide/>
          </group_summary>
          <meta tag="hidden">
            <instanceID/>
            <instanceName/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="frequency">
        <root>
          <item>
            <name>0</name>
            <label>Not at all</label>
          </item>
          <item>
            <name>1</name>
            <label>Several days</label>
          </item>
          <item>
            <name>2</name>
            <label>More than half the days</label>
          </item>
          <item>
            <name>3</name>
            <label>Nearly every day</label>
          </item>
        </root>
      </instance>
      <instance id="states">
        <root>
          <item>
            <name>kerala</name>
            <label>Kerala</label>
          </item>
          <item>
            <name>tamil_nadu</name>
            <label>Tamil Nadu</label>
          </item>
          <item>
            <name>andhra_pradesh</name>
            <label>Andhra Pradesh</label>
          </item>
          <item>
            <name>telangana</name>
            <label>Telangana</label>
          </item>
          <item>
            <name>karnataka</name>
            <label>Karnataka</label>
          </item>
        </root>
      </instance>
      <instance id="districts">
        <root>
          <item>
            <name>chennai</name>
            <label>Chennai</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>thanjavur</name>
            <label>Thanjavur</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>coimbatore</name>
            <label>Coimbatore</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>madurai</name>
            <label>Madurai</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>salem</name>
            <label>Salem</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>tiruchirappalli</name>
            <label>Tiruchirappalli</label>
            <filter>tamil_nadu</filter>
          </item>
          <item>
            <name>thiruvananthapuram</name>
            <label>Thiruvananthapuram</label>
            <filter>kerala</filter>
          </item>
          <item>
            <name>kochi</name>
            <label>Kochi</label>
