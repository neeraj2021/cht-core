            <label>Tirupati</label>
            <filter>andhra_pradesh</filter>
          </item>
          <item>
            <name>kurnool</name>
            <label>Kurnool</label>
            <filter>andhra_pradesh</filter>
          </item>
          <item>
            <name>hyderabad</name>
            <label>Hyderabad</label>
            <filter>telangana</filter>
          </item>
          <item>
            <name>warangal</name>
            <label>Warangal</label>
            <filter>telangana</filter>
          </item>
          <item>
            <name>nizamabad</name>
            <label>Nizamabad</label>
            <filter>telangana</filter>
          </item>
          <item>
            <name>karimnagar</name>
            <label>Karimnagar</label>
            <filter>telangana</filter>
          </item>
          <item>
            <name>khammam</name>
            <label>Khammam</label>
            <filter>telangana</filter>
          </item>
          <item>
            <name>bengaluru</name>
            <label>Bengaluru</label>
            <filter>karnataka</filter>
          </item>
          <item>
            <name>mysuru</name>
            <label>Mysuru</label>
            <filter>karnataka</filter>
          </item>
          <item>
            <name>hubli</name>
            <label>Hubli</label>
            <filter>karnataka</filter>
          </item>
          <item>
            <name>mangaluru</name>
            <label>Mangaluru</label>
            <filter>karnataka</filter>
          </item>
          <item>
            <name>belagavi</name>
            <label>Belagavi</label>
            <filter>karnataka</filter>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/patient_id" type="string" calculate="../inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/reporter_name" type="string" calculate="../inputs/user/name"/>
      <bind nodeset="/data/reporter_place" type="string" calculate="instance('user-contact-summary')/context/facility_name"/>
      <bind nodeset="/data/title" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/page_info/lbl_about_phq9" readonly="true()" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/inputs/user/phone" type="string"/>
      <bind nodeset="/data/inputs/reporter_name_note" readonly="true()" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="string" required="true()"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/state" type="string" required="true()"/>
      <bind nodeset="/data/inputs/district" type="string" required="true()"/>
      <bind nodeset="/data/instructions/instructions_1" readonly="true()" type="string"/>
      <bind nodeset="/data/instructions/Instructions_2" readonly="true()" type="string"/>
      <bind nodeset="/data/instructions/Instructions_3" readonly="true()" type="string"/>
      <bind nodeset="/data/instructions/Instructions_4" readonly="true()" type="string"/>
      <bind nodeset="/data/instructions/Instructions_5" readonly="true()" type="string"/>
      <bind nodeset="/data/instructions/Instructions_6" readonly="true()" type="string"/>
      <bind nodeset="/data/page_1/little_interest_or_pleasure" type="string" required="true()"/>
      <bind nodeset="/data/page_1/feeling_depressed_or_hopeless" type="string" required="true()"/>
      <bind nodeset="/data/page_2/trouble_sleeping" type="string" required="true()"/>
      <bind nodeset="/data/page_2/feeling_tired" type="string" required="true()"/>
      <bind nodeset="/data/page_3/poor_appetite_or_overeating" type="string" required="true()"/>
      <bind nodeset="/data/page_3/feeling_bad_about_yourself" type="string" required="true()"/>
      <bind nodeset="/data/page_4/trouble_concentrating" type="string" required="true()"/>
      <bind nodeset="/data/page_4/moving_or_speaking_slowly" type="string" required="true()"/>
      <bind nodeset="/data/page_5/thoughts_of_self_harm" type="string" required="true()"/>
      <bind nodeset="/data/total_score" type="string" calculate=" /data/page_1/little_interest_or_pleasure  +  /data/page_1/feeling_depressed_or_hopeless  +  /data/page_2/trouble_sleeping  +  /data/page_2/feeling_tired  +  /data/page_3/poor_appetite_or_overeating  +  /data/page_3/feeling_bad_about_yourself  +  /data/page_4/trouble_concentrating  +  /data/page_4/moving_or_speaking_slowly  +  /data/page_5/thoughts_of_self_harm "/>
      <bind nodeset="/data/severity_category" type="string" calculate="if( /data/total_score  &lt;= 4, 'minimal', if( /data/total_score  &lt;= 9, 'mild', if( /data/total_score  &lt;= 14, 'moderate', if( /data/total_score  &lt;= 19, 'moderately_severe', 'severe'))))"/>
      <bind nodeset="/data/group_summary/grp_lbl_filled_by/lbl_filled_by_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_filled_by/calc_reporter_name" type="string" calculate=" /data/reporter_name "/>
      <bind nodeset="/data/group_summary/grp_lbl_patient/lbl_patient_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_patient/calc_patient_name" type="string" calculate=" /data/patient_name "/>
      <bind nodeset="/data/group_summary/grp_lbl_state/lbl_state_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_state/calc_state" type="string" calculate="jr:choice-name( /data/inputs/state , ' /data/inputs/state ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_district/lbl_district_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_district/calc_district" type="string" calculate="jr:choice-name( /data/inputs/district , ' /data/inputs/district ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_q1/lbl_q1_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_q1/calc_q1" type="string" calculate="jr:choice-name( /data/page_1/little_interest_or_pleasure , ' /data/page_1/little_interest_or_pleasure ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_q2/lbl_q2_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_q2/calc_q2" type="string" calculate="jr:choice-name( /data/page_1/feeling_depressed_or_hopeless , ' /data/page_1/feeling_depressed_or_hopeless ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_q3/lbl_q3_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_q3/calc_q3" type="string" calculate="jr:choice-name( /data/page_2/trouble_sleeping , ' /data/page_2/trouble_sleeping ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_q4/lbl_q4_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_q4/calc_q4" type="string" calculate="jr:choice-name( /data/page_2/feeling_tired , ' /data/page_2/feeling_tired ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_q5/lbl_q5_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_q5/calc_q5" type="string" calculate="jr:choice-name( /data/page_3/poor_appetite_or_overeating , ' /data/page_3/poor_appetite_or_overeating ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_q6/lbl_q6_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_q6/calc_q6" type="string" calculate="jr:choice-name( /data/page_3/feeling_bad_about_yourself , ' /data/page_3/feeling_bad_about_yourself ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_q7/lbl_q7_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_q7/calc_q7" type="string" calculate="jr:choice-name( /data/page_4/trouble_concentrating , ' /data/page_4/trouble_concentrating ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_q8/lbl_q8_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_q8/calc_q8" type="string" calculate="jr:choice-name( /data/page_4/moving_or_speaking_slowly , ' /data/page_4/moving_or_speaking_slowly ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_q9/lbl_q9_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_q9/calc_q9" type="string" calculate="jr:choice-name( /data/page_5/thoughts_of_self_harm , ' /data/page_5/thoughts_of_self_harm ')"/>
      <bind nodeset="/data/group_summary/grp_lbl_score/lbl_score_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_score/calc_total_score" type="string" calculate=" /data/total_score "/>
      <bind nodeset="/data/group_summary/grp_lbl_severity/lbl_severity_lbl" readonly="true()" type="string"/>
      <bind nodeset="/data/group_summary/grp_lbl_severity/calc_severity_category" type="string" calculate="if( /data/severity_category  = 'minimal', 'Minimal (0–4)', if( /data/severity_category  = 'mild', 'Mild (5–9)', if( /data/severity_category  = 'moderate', 'Moderate (10–14)', if( /data/severity_category  = 'moderately_severe', 'Moderately Severe (15–19)', if( /data/severity_category  = 'severe', 'Severe (20–27)',  /data/severity_category )))))"/>
      <bind nodeset="/data/group_summary/severity_guide" readonly="true()" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
      <bind nodeset="/data/meta/instanceName" type="string" calculate=" /data/title "/>
    </model>
  </h:head>
  <h:body class="pages grid-layout">
    <group appearance="field-list" ref="/data/page_info">
      <label>About PHQ-9</label>
      <input ref="/data/page_info/lbl_about_phq9">
        <label>PHQ-9 is used for screening for depression</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/inputs">
      <label>Patient &amp; Reporter Info</label>
      <group ref="/data/inputs/user"/>
      <input ref="/data/inputs/reporter_name_note">
        <label> Filled by: <output value=" /data/reporter_name "/></label>
      </input>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="select-contact type-person role-patient">
          <label>Patient's Name</label>
          <hint>Select the patient from your area</hint>
        </input>
        <input ref="/data/inputs/contact/patient_id" appearance="hidden">
          <label>Medic ID</label>
        </input>
        <input ref="/data/inputs/contact/name" appearance="hidden">
          <label>Patient Name</label>
        </input>
      </group>
      <select1 ref="/data/inputs/state" appearance="minimal">
        <label>State</label>
        <itemset nodeset="instance('states')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/inputs/district" appearance="minimal">
        <label>District</label>
        <itemset nodeset="instance('districts')/root/item[filter =  /data/inputs/state ]">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/instructions">
      <input ref="/data/instructions/instructions_1">
        <label>PHQ-9: Patient Health Questionnaire</label>
      </input>
      <input ref="/data/instructions/Instructions_2">
        <label>Over the last 2 weeks, how often have you been bothered by any of the following problems? Answer all 9 questions. Each question is scored:</label>
      </input>
      <input ref="/data/instructions/Instructions_3">
        <label>Not at all=0,</label>
      </input>
      <input ref="/data/instructions/Instructions_4">
        <label>Several days=1,</label>
      </input>
      <input ref="/data/instructions/Instructions_5">
        <label>More than half the days=2,</label>
      </input>
      <input ref="/data/instructions/Instructions_6">
        <label>Nearly every day=3</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/page_1">
      <label>Questions 1 &amp; 2 of 9</label>
      <select1 ref="/data/page_1/little_interest_or_pleasure">
        <label>1. Little interest or pleasure in doing things</label>
        <hint>Use ✓ to indicate your answer</hint>
        <itemset nodeset="instance('frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_1/feeling_depressed_or_hopeless">
        <label>2. Feeling down, depressed, or hopeless</label>
        <hint>Use ✓ to indicate your answer</hint>
        <itemset nodeset="instance('frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_2">
      <label>Questions 3 &amp; 4 of 9</label>
      <select1 ref="/data/page_2/trouble_sleeping">
        <label>3. Trouble falling or staying asleep, or sleeping too much</label>
        <hint>Use ✓ to indicate your answer</hint>
        <itemset nodeset="instance('frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_2/feeling_tired">
        <label>4. Feeling tired or having little energy</label>
        <hint>Use ✓ to indicate your answer</hint>
        <itemset nodeset="instance('frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_3">
      <label>Questions 5 &amp; 6 of 9</label>
      <select1 ref="/data/page_3/poor_appetite_or_overeating">
        <label>5. Poor appetite or overeating</label>
        <hint>Use ✓ to indicate your answer</hint>
        <itemset nodeset="instance('frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_3/feeling_bad_about_yourself">
        <label>6. Feeling bad about yourself — or that you are a failure or have let yourself or your family down</label>
        <hint>Use ✓ to indicate your answer</hint>
        <itemset nodeset="instance('frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_4">
      <label>Questions 7 &amp; 8 of 9</label>
      <select1 ref="/data/page_4/trouble_concentrating">
        <label>7. Trouble concentrating on things, such as reading the newspaper or watching television</label>
        <hint>Use ✓ to indicate your answer</hint>
        <itemset nodeset="instance('frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/page_4/moving_or_speaking_slowly">
        <label>8. Moving or speaking so slowly that other people could have noticed? Or the opposite — being so fidgety or restless that you have been moving around a lot more than usual</label>
        <hint>Use ✓ to indicate your answer</hint>
        <itemset nodeset="instance('frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/page_5">
      <label>Question 9 of 9</label>
      <select1 ref="/data/page_5/thoughts_of_self_harm">
        <label>9. Thoughts that you would be better off dead or of hurting yourself in some way</label>
        <hint>Use ✓ to indicate your answer</hint>
        <itemset nodeset="instance('frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/group_summary">
