      <input ref="/data/patient/name">
        <label ref="jr:itext('/data/patient/name:label')"/>
      </input>
      <input ref="/data/patient/short_name">
        <label ref="jr:itext('/data/patient/short_name:label')"/>
        <hint ref="jr:itext('/data/patient/short_name:hint')"/>
      </input>
      <group ref="/data/patient/ephemeral_dob">
        <input ref="/data/patient/ephemeral_dob/dob_calendar">
          <label ref="jr:itext('/data/patient/ephemeral_dob/dob_calendar:label')"/>
          <hint ref="jr:itext('/data/patient/ephemeral_dob/dob_calendar:hint')"/>
        </input>
        <input ref="/data/patient/ephemeral_dob/age_label">
          <label ref="jr:itext('/data/patient/ephemeral_dob/age_label:label')"/>
        </input>
        <input ref="/data/patient/ephemeral_dob/age_years">
          <label ref="jr:itext('/data/patient/ephemeral_dob/age_years:label')"/>
        </input>
        <input ref="/data/patient/ephemeral_dob/age_months">
          <label ref="jr:itext('/data/patient/ephemeral_dob/age_months:label')"/>
        </input>
        <select ref="/data/patient/ephemeral_dob/dob_method" appearance="columns">
          <itemset nodeset="instance('select_dob_method')/root/item">
            <value ref="name"/>
            <label ref="jr:itext(itextId)"/>
          </itemset>
        </select>
        <input ref="/data/patient/ephemeral_dob/dob_debug">
          <label ref="jr:itext('/data/patient/ephemeral_dob/dob_debug:label')"/>
        </input>
      </group>
      <select1 ref="/data/patient/sex" appearance="columns">
        <label ref="jr:itext('/data/patient/sex:label')"/>
        <itemset nodeset="instance('male_female')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/patient/phone">
        <label ref="jr:itext('/data/patient/phone:label')"/>
      </input>
      <input ref="/data/patient/phone_alternate">
        <label ref="jr:itext('/data/patient/phone_alternate:label')"/>
      </input>
      <input ref="/data/patient/display_user_role">
        <label ref="jr:itext('/data/patient/display_user_role:label')"/>
      </input>
      <select1 ref="/data/patient/role">
        <label ref="jr:itext('/data/patient/role:label')"/>
        <hint ref="jr:itext('/data/patient/role:hint')"/>
        <itemset nodeset="instance('roles')/root/item[selected(creator_role,  /data/patient/created_by_role )]">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/patient/role_other">
        <label ref="jr:itext('/data/patient/role_other:label')"/>
      </input>
      <input ref="/data/patient/external_id">
        <label ref="jr:itext('/data/patient/external_id:label')"/>
      </input>
      <input ref="/data/patient/notes" appearance="multiline">
        <label ref="jr:itext('/data/patient/notes:label')"/>
      </input>
      <group ref="/data/patient/user_for_contact"/>
      <group appearance="hidden" ref="/data/patient/meta"/>
    </group>
  </h:body>
</h:html>