      <bind nodeset="/data/patient/date_of_birth_method" type="string" calculate="../ephemeral_dob/dob_method"/>
      <bind nodeset="/data/patient/ephemeral_dob/dob_calendar" type="date" required="true()" relevant="not(selected(../dob_method,'approx'))" constraint=". &lt;= now()" jr:constraintMsg="jr:itext('/data/patient/ephemeral_dob/dob_calendar:jr:constraintMsg')"/>
      <bind nodeset="/data/patient/ephemeral_dob/age_label" readonly="true()" type="string" relevant="selected(../dob_method,'approx')"/>
      <bind nodeset="/data/patient/ephemeral_dob/age_years" type="int" required="true()" relevant="selected(../dob_method,'approx')" constraint=". &gt;= 0 and . &lt;= 130" jr:constraintMsg="jr:itext('/data/patient/ephemeral_dob/age_years:jr:constraintMsg')"/>
      <bind nodeset="/data/patient/ephemeral_dob/age_months" type="int" relevant="selected(../dob_method,'approx')" constraint=". &gt;= 0 and . &lt;= 11" jr:constraintMsg="jr:itext('/data/patient/ephemeral_dob/age_months:jr:constraintMsg')"/>
      <bind nodeset="/data/patient/ephemeral_dob/dob_method" type="string"/>
      <bind nodeset="/data/patient/ephemeral_dob/dob_approx" type="string" calculate="add-date(today(), 0- /data/patient/ephemeral_dob/age_years , 0- /data/patient/ephemeral_dob/age_months )"/>
      <bind nodeset="/data/patient/ephemeral_dob/dob_raw" type="string" calculate="if(not(selected(  /data/patient/ephemeral_dob/dob_method ,'approx')), &#10; /data/patient/ephemeral_dob/dob_calendar ,&#10; /data/patient/ephemeral_dob/dob_approx )"/>
      <bind nodeset="/data/patient/ephemeral_dob/dob_iso" type="string" calculate="format-date-time(../dob_raw,&quot;%Y-%m-%d&quot;)"/>
      <bind nodeset="/data/patient/ephemeral_dob/dob_debug" readonly="true()" type="string" relevant="false()"/>
      <bind nodeset="/data/patient/sex" type="string" required="true()"/>
      <bind nodeset="/data/patient/phone" type="tel" constraint="true()" jr:constraintMsg="jr:itext('/data/patient/phone:jr:constraintMsg')"/>
      <bind nodeset="/data/patient/phone_alternate" type="tel" constraint="true()" jr:constraintMsg="jr:itext('/data/patient/phone_alternate:jr:constraintMsg')"/>
      <bind nodeset="/data/patient/display_user_role" readonly="true()" type="string" relevant="false()"/>
      <bind nodeset="/data/patient/role" type="string"/>
      <bind nodeset="/data/patient/role_other" type="string" required="true()" relevant="selected(  /data/patient/role ,'other')"/>
      <bind nodeset="/data/patient/external_id" type="string"/>
      <bind nodeset="/data/patient/notes" type="string"/>
      <bind nodeset="/data/patient/user_for_contact/create" type="string" calculate="false()"/>
      <bind nodeset="/data/patient/meta/created_by" type="string" calculate="../../../inputs/user/name"/>
      <bind nodeset="/data/patient/meta/created_by_person_uuid" type="string" calculate="../../../inputs/user/contact_id"/>
      <bind nodeset="/data/patient/meta/created_by_place_uuid" type="string" calculate="../../../inputs/user/facility_id"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
